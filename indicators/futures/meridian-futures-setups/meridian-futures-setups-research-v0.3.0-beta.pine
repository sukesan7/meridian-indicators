//@version=6
indicator(
     "Meridian — Futures Setups Research",
     shorttitle = "Meridian Setups Research",
     overlay = true,
     max_bars_back = 5000,
     max_lines_count = 500,
     max_boxes_count = 500,
     max_labels_count = 500,
     dynamic_requests = true)

// Meridian — Futures Setups v0.3.0-beta
// Meridian Choice confluence engine. No named strategy playbooks.
// Build: research
// Primary chart: NQ/ES 1-minute, with extended-hours data enabled.
// Higher-timeframe zones use confirmed bars only. Signals occur on confirmed
// chart bars only and are never moved backward to historical origin candles.

const string VERSION = "0.3.0-beta"
const bool RESEARCH_BUILD = true
const int DIR_BULL = 1
const int DIR_BEAR = -1
const int DIR_NONE = 0

const int Z_ACTIVE = 0
const int Z_TRIGGERED = 1
const int Z_INVALID = 2
const int Z_EXPIRED = 3

const int T_ACTIVE = 0
const int T_COMPLETED = 1
const int T_STOPPED = 2
const int T_EXPIRED = 3

const int MAX_ZONES = 140
const int MAX_PIVOTS = 60
const int MAX_TRADES = 20
const int MAX_SESSION_SLOTS = 1500
const int MAX_RVOL_SESSIONS = 60

// ─────────────────────────────────────────────────────────────────────────────
// State objects
// ─────────────────────────────────────────────────────────────────────────────
type Zone
    string id
    string zoneType
    string sourceTf
    int sourceRank
    int direction
    float top
    float bottom
    float midpoint
    float sourceAtr
    int detectedTime
    int detectedBar
    int expiryTime
    int state
    int touchCount
    float fillPercent
    int score
    int categoryCount
    string scoreBreakdown
    string rejectionReason
    int structuralLegId
    box zoneBox
    label zoneLabel

type PivotMark
    float price
    int side
    int originBar
    int originTime

type Trade
    string id
    string zoneId
    string zoneType
    string sourceTf
    int direction
    int state
    int score
    int categoryCount
    string evidence
    int entryTime
    int entryBar
    int plannedEndTime
    int terminalTime
    float entryPrice
    float stopPrice
    float target1
    float target15
    float target2
    bool target1Hit
    bool target15Hit
    box setupBox
    box riskBox
    box reward1Box
    box reward15Box
    box reward2Box
    line stopLine
    line target1Line
    line target15Line
    line target2Line
    label signalLabel
    label stopLabel
    label target1Label
    label target15Label
    label target2Label
    label outcomeLabel

var Zone[] zones = array.new<Zone>()
var PivotMark[] pivotMarks = array.new<PivotMark>()
var Trade[] trades = array.new<Trade>()
var int[] researchBucketSignals = array.new_int(5, 0)
var int[] researchBucketWins = array.new_int(5, 0)
var int[] researchBucketStops = array.new_int(5, 0)

// ─────────────────────────────────────────────────────────────────────────────
// Inputs
// ─────────────────────────────────────────────────────────────────────────────
const string G_GENERAL = "01 — General"
const string G_TIMEFRAMES = "02 — Zone Timeframes"
const string G_CONCEPTS = "03 — Concepts"
const string G_STRUCTURE = "04 — Structure + Liquidity"
const string G_CONTEXT = "05 — Context"
const string G_SCORING = "06 — Meridian Choice Scoring"
const string G_EXECUTION = "07 — Execution + Risk"
const string G_VISUAL = "08 — Visuals"
const string G_RESEARCH = "09 — Research"
const string G_ALERTS = "10 — Alerts"

bool indicatorEnabled = input.bool(true, "Enable indicator", group = G_GENERAL)
bool allowUnsupportedSymbols = input.bool(false, "Allow symbols other than NQ/ES", group = G_GENERAL)
string sessionTimezone = input.string("America/New_York", "Session timezone", group = G_GENERAL)
string futuresSession = input.session("1800-1700:1234567", "Futures session", group = G_GENERAL)
string overnightSession = input.session("1800-0930:1234567", "Overnight session", group = G_GENERAL)
string rthSession = input.session("0930-1600:23456", "Regular trading hours", group = G_GENERAL)
string signalSession = input.session("0800-1600:23456", "Signal window", tooltip = "Default includes pre-market and RTH.", group = G_GENERAL)
int maximumActiveTrades = input.int(1, "Maximum active trades", minval = 1, maxval = 3, group = G_GENERAL)
bool showPastTrades = input.bool(false, "Show past trades", group = G_GENERAL)
int pastTradeRetentionHours = input.int(22, "Past-trade retention hours", minval = 1, maxval = 72, group = G_GENERAL, active = showPastTrades)
int completedRetentionMinutes = input.int(5, "Default completed-trade retention", minval = 0, maxval = 120, group = G_GENERAL, active = not showPastTrades)

bool useChartZones = input.bool(true, "Chart-timeframe zones", group = G_TIMEFRAMES)
bool use5m = input.bool(true, "5-minute", inline = "tf1", group = G_TIMEFRAMES)
bool use15m = input.bool(true, "15-minute", inline = "tf1", group = G_TIMEFRAMES)
bool use30m = input.bool(true, "30-minute", inline = "tf1", group = G_TIMEFRAMES)
bool use1h = input.bool(true, "1-hour", inline = "tf2", group = G_TIMEFRAMES)
bool use4h = input.bool(true, "4-hour", inline = "tf2", group = G_TIMEFRAMES)
int chartZoneLifeMinutes = input.int(45, "Chart-zone life", minval = 5, maxval = 240, group = G_TIMEFRAMES)
int zoneLife5m = input.int(120, "5m zone life", minval = 15, maxval = 720, group = G_TIMEFRAMES)
int zoneLife15m = input.int(360, "15m zone life", minval = 30, maxval = 1440, group = G_TIMEFRAMES)
int zoneLife30m = input.int(720, "30m zone life", minval = 60, maxval = 2880, group = G_TIMEFRAMES)
int zoneLife1h = input.int(1440, "1H zone life", minval = 120, maxval = 4320, group = G_TIMEFRAMES)
int zoneLife4h = input.int(4320, "4H zone life", minval = 240, maxval = 10080, group = G_TIMEFRAMES)

bool enableFvg = input.bool(true, "Fair Value Gaps", group = G_CONCEPTS)
bool enableIfvg = input.bool(true, "Inversion FVGs", group = G_CONCEPTS)
