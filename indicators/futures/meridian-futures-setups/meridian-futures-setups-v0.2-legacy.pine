//@version=6
indicator(
     "Meridian — Futures Setups",
     shorttitle = "Meridian Futures Setups",
     overlay = true,
     max_bars_back = 5000,
     max_lines_count = 500,
     max_boxes_count = 500,
     max_labels_count = 500,
     dynamic_requests = true)

// Meridian — Futures Setups v0.2.0
// Stateful liquidity, structure, zone, confluence, and trade-hypothesis engine.
// Initial markets: NQ, MNQ, ES, MES.
// Confirmed bars and confirmed higher-timeframe values are the default.
// The script is an analytical tool. It does not place broker orders.

// ─────────────────────────────────────────────────────────────────────────────
// Constants and state codes
// ─────────────────────────────────────────────────────────────────────────────
const string VERSION = "0.2.0"
const int DIR_BULL = 1
const int DIR_BEAR = -1
const int DIR_NONE = 0

const int LIQ_ACTIVE = 0
const int LIQ_TOUCHED = 1
const int LIQ_PENETRATED = 2
const int LIQ_RECLAIMED = 3
const int LIQ_ACCEPTED = 4
const int LIQ_CONSUMED = 5
const int LIQ_EXPIRED = 6

const int Z_DETECTED = 0
const int Z_CANDIDATE = 1
const int Z_UNQUALIFIED = 2
const int Z_QUALIFIED = 3
const int Z_ARMED = 4
const int Z_ENTRY_PENDING = 5
const int Z_TRIGGERED = 6
const int Z_INVALIDATED = 7
const int Z_EXPIRED = 8
const int Z_SUPERSEDED = 9
const int Z_REJECTED = 10
const int Z_INVERTED = 11

const int T_ACTIVE = 0
const int T_TARGET_1 = 1
const int T_TARGET_1_5 = 2
const int T_COMPLETED = 3
const int T_STOPPED = 4
const int T_STOPPED_PARTIAL = 5
const int T_CANCELLED = 6
const int T_TIME_EXPIRED = 7

const int MAX_LIQUIDITY = 180
const int MAX_SWEEP_EVENTS = 30
const int MAX_ZONES = 90
const int MAX_TRADES_HARD = 20
const int MAX_RTH_SLOTS = 500

// ─────────────────────────────────────────────────────────────────────────────
// User-defined types
// ─────────────────────────────────────────────────────────────────────────────
type LiquidityLevel
    string id
    string source
    string sourceTf
    float price
    int formationTime
    int formationBar
    int side
    int state
    int testCount
    float maxPenetrationTicks
    int penetrationBar
    int beyondCloses
    int expiryTime

// A direction of +1 means that a low-side sweep supports a bullish reversal.
// A direction of -1 means that a high-side sweep supports a bearish reversal.
type SweepEvent
    string id
    int direction
    string source
    float levelPrice
    float sweepExtreme
    int sweepTime
    int sweepBar
    int reclaimTime
    int reclaimBar
    int confluenceCount
    bool firstInteraction
    int expiryBar

// Zone state is stored independently from trade state. A zone can expire,
// invert, or be superseded before it creates a trade.
type SetupZone
    string id
    string zoneType
    int direction
    float top
    float bottom
    float midpoint
    int originTime
    int originBar
    int structuralLegId
    int state
    int score
    int scoreLiquidity
    int scoreStructure
    int scoreZone
    int scoreHtf
    int scoreSmt
    int scoreSession
    int scoreLocation
    string scoreText
    string strategyName
    string strategyMatches
    string rejectionReason
    int touchCount
    float fillPercent
    int expiryTime
    int qualifiedTime
    int armedTime
    int entryPendingBar
    int linkedSweepBar
    float linkedLiquidityPrice
    float linkedSweepExtreme
    string linkedLiquiditySource
    string structureType
    bool originDisplacement
    bool transformed
    int failedBar
    float invalidationPrice
    box zoneBox
    label zoneLabel
    line midpointLine
    line sourceLine
    label sourceLabel

type TradeHypothesis
    string id
    string zoneId
    string zoneType
    string strategyName
    string strategyMatches
    int direction
    int state
    int entryTime
    int entryBar
    int plannedEndTime
    int terminalTime
    float entryPrice
    float stopPrice
    float target1
    float target15
    float target2
    bool target1Hit
    bool target15Hit
    bool target2Hit
    int terminalBar
    int score
    string evidence
    box zoneBox
    box riskBox
    box reward1Box
    box reward15Box
    box reward2Box
    label signalLabel
    line entryLine
    line stopLine
    line target1Line
    line target15Line
    line target2Line
    label entryLabel
    label stopLabel
    label target1Label
    label target15Label
    label target2Label
    label outcomeLabel

var LiquidityLevel[] liquidityLevels = array.new<LiquidityLevel>()
var SweepEvent[] sweepEvents = array.new<SweepEvent>()
var SetupZone[] setupZones = array.new<SetupZone>()
var TradeHypothesis[] trades = array.new<TradeHypothesis>()

// ─────────────────────────────────────────────────────────────────────────────
// Input groups
// ─────────────────────────────────────────────────────────────────────────────
const string G_GENERAL = "01 — General"
const string G_STRATEGIES = "02 — Strategy Playbook"
const string G_SESSIONS = "03 — Sessions"
const string G_LIQUIDITY = "04 — Liquidity Registry"
const string G_STRUCTURE = "05 — Structure + Displacement"
const string G_ZONES = "06 — FVG / IFVG / OB / BB"
const string G_SMT = "07 — NQ / ES SMT"
const string G_SCORING = "08 — Confluence Scoring"
const string G_ENTRY = "09 — Entry + Trade Lifecycle"
const string G_VISUAL = "10 — Visuals"
const string G_ALERTS = "11 — Alerts + Research"

bool indicatorEnabled = input.bool(true, "Enable indicator", group = G_GENERAL)
