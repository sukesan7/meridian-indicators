bool allowUnsupportedSymbols = input.bool(false, "Allow unsupported symbols", tooltip = "Automatic SMT pairing is disabled on unsupported symbols.", group = G_GENERAL)
int maximumVisibleTrades = input.int(3, "Maximum active trades", minval = 1, maxval = 3, group = G_GENERAL)
bool showPastTrades = input.bool(false, "Show past trades", tooltip = "When enabled, terminal trades remain in a faded historical state for the configured retention period.", group = G_GENERAL)
int pastTradeRetentionHours = input.int(22, "Past-trade retention hours", minval = 1, maxval = 72, group = G_GENERAL, active = showPastTrades)
int maximumRetainedTrades = input.int(20, "Maximum retained trades", minval = 3, maxval = MAX_TRADES_HARD, group = G_GENERAL)

