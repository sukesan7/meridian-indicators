// ─────────────────────────────────────────────────────────────────────────────
// Helper functions
// ─────────────────────────────────────────────────────────────────────────────
f_clamp(float value, float minimumValue, float maximumValue) =>
    math.max(minimumValue, math.min(maximumValue, value))

f_safe_ratio(float numerator, float denominator) =>
    not na(denominator) and math.abs(denominator) > 1e-12 ? numerator / denominator : na

f_label_size(string sizeName) =>
    switch sizeName
        "Tiny" => size.tiny
        "Normal" => size.normal
        "Large" => size.large
        => size.small

f_table_position(string positionName) =>
    switch positionName
        "Top Left" => position.top_left
        "Bottom Right" => position.bottom_right
        "Bottom Left" => position.bottom_left
        => position.top_right

f_in_session(string sessionString) =>
    not na(time(timeframe.period, sessionString, sessionTimezone))

f_date_key() =>
    year(time, sessionTimezone) * 10000 + month(time, sessionTimezone) * 100 + dayofmonth(time, sessionTimezone)

f_window_active(int startHour, int startMinute, int durationMinutes) =>
    int startTimestamp = timestamp(sessionTimezone, year(time, sessionTimezone), month(time, sessionTimezone), dayofmonth(time, sessionTimezone), startHour, startMinute)
    int endTimestamp = startTimestamp + durationMinutes * 60 * 1000
    timeframe.isintraday and time < endTimestamp and time_close > startTimestamp

f_state_terminal_zone(int stateValue) =>
    stateValue == Z_INVALIDATED or stateValue == Z_EXPIRED or stateValue == Z_SUPERSEDED or stateValue == Z_REJECTED or stateValue == Z_INVERTED

f_state_terminal_trade(int stateValue) =>
    stateValue == T_COMPLETED or stateValue == T_STOPPED or stateValue == T_STOPPED_PARTIAL or stateValue == T_CANCELLED or stateValue == T_TIME_EXPIRED

f_direction_text(int directionValue) =>
    directionValue == DIR_BULL ? "BUY" : directionValue == DIR_BEAR ? "SELL" : "NONE"

f_zone_minutes(string zoneTypeValue) =>
    zoneTypeValue == "OB" or zoneTypeValue == "BB" ? obLifeMinutes : fvgLifeMinutes

f_json_safe(string sourceText) =>
    str.replace_all(str.replace_all(sourceText, "\\", "/"), "\"", "'")

f_new_id(string prefix, int eventTime, int eventBar) =>
    prefix + "-" + str.tostring(eventTime) + "-" + str.tostring(eventBar)

f_delete_zone_drawings(SetupZone zoneValue) =>
    if not na(zoneValue.zoneBox)
        box.delete(zoneValue.zoneBox)
        zoneValue.zoneBox := na
    if not na(zoneValue.zoneLabel)
        label.delete(zoneValue.zoneLabel)
        zoneValue.zoneLabel := na
    if not na(zoneValue.midpointLine)
        line.delete(zoneValue.midpointLine)
        zoneValue.midpointLine := na
    if not na(zoneValue.sourceLine)
        line.delete(zoneValue.sourceLine)
        zoneValue.sourceLine := na
    if not na(zoneValue.sourceLabel)
        label.delete(zoneValue.sourceLabel)
        zoneValue.sourceLabel := na

f_delete_trade_drawings(TradeHypothesis tradeValue) =>
    if not na(tradeValue.zoneBox)
        box.delete(tradeValue.zoneBox)
        tradeValue.zoneBox := na
    if not na(tradeValue.riskBox)
        box.delete(tradeValue.riskBox)
        tradeValue.riskBox := na
    if not na(tradeValue.reward1Box)
        box.delete(tradeValue.reward1Box)
        tradeValue.reward1Box := na
    if not na(tradeValue.reward15Box)
        box.delete(tradeValue.reward15Box)
        tradeValue.reward15Box := na
    if not na(tradeValue.reward2Box)
        box.delete(tradeValue.reward2Box)
        tradeValue.reward2Box := na
    if not na(tradeValue.signalLabel)
        label.delete(tradeValue.signalLabel)
        tradeValue.signalLabel := na
    if not na(tradeValue.entryLine)
        line.delete(tradeValue.entryLine)
        tradeValue.entryLine := na
    if not na(tradeValue.stopLine)
        line.delete(tradeValue.stopLine)
        tradeValue.stopLine := na
    if not na(tradeValue.target1Line)
        line.delete(tradeValue.target1Line)
        tradeValue.target1Line := na
    if not na(tradeValue.target15Line)
        line.delete(tradeValue.target15Line)
        tradeValue.target15Line := na
    if not na(tradeValue.target2Line)
        line.delete(tradeValue.target2Line)
        tradeValue.target2Line := na
    if not na(tradeValue.entryLabel)
        label.delete(tradeValue.entryLabel)
        tradeValue.entryLabel := na
    if not na(tradeValue.stopLabel)
        label.delete(tradeValue.stopLabel)
        tradeValue.stopLabel := na
    if not na(tradeValue.target1Label)
        label.delete(tradeValue.target1Label)
        tradeValue.target1Label := na
    if not na(tradeValue.target15Label)
        label.delete(tradeValue.target15Label)
        tradeValue.target15Label := na
    if not na(tradeValue.target2Label)
        label.delete(tradeValue.target2Label)
        tradeValue.target2Label := na
    if not na(tradeValue.outcomeLabel)
        label.delete(tradeValue.outcomeLabel)
        tradeValue.outcomeLabel := na

f_liquidity_exists(string sourceValue, float priceValue, int sideValue) =>
    bool exists = false
    if array.size(liquidityLevels) > 0
        for i = 0 to array.size(liquidityLevels) - 1
            LiquidityLevel levelValue = array.get(liquidityLevels, i)
            if levelValue.state != LIQ_EXPIRED and levelValue.state != LIQ_ACCEPTED and levelValue.side == sideValue and levelValue.source == sourceValue and math.abs(levelValue.price - priceValue) <= syminfo.mintick * 0.25
                exists := true
                break
    exists

f_register_liquidity(string sourceValue, string sourceTfValue, float priceValue, int formationTimeValue, int formationBarValue, int sideValue) =>
    if indicatorEnabled and not na(priceValue) and not f_liquidity_exists(sourceValue, priceValue, sideValue)
        string levelId = f_new_id("LIQ-" + sourceValue, formationTimeValue, formationBarValue)
        int expiryValue = formationTimeValue + liquidityLifeHours * 60 * 60 * 1000
        LiquidityLevel newLevel = LiquidityLevel.new(
             id = levelId,
             source = sourceValue,
             sourceTf = sourceTfValue,
             price = priceValue,
             formationTime = formationTimeValue,
             formationBar = formationBarValue,
             side = sideValue,
             state = LIQ_ACTIVE,
             testCount = 0,
             maxPenetrationTicks = 0.0,
             penetrationBar = na,
             beyondCloses = 0,
             expiryTime = expiryValue)
        array.push(liquidityLevels, newLevel)

f_count_liquidity_confluence(float priceValue, int sideValue, float toleranceValue) =>
    int countValue = 0
    if array.size(liquidityLevels) > 0
        for i = 0 to array.size(liquidityLevels) - 1
            LiquidityLevel levelValue = array.get(liquidityLevels, i)
            if levelValue.side == sideValue and levelValue.state != LIQ_ACCEPTED and levelValue.state != LIQ_EXPIRED and math.abs(levelValue.price - priceValue) <= toleranceValue
                countValue += 1
    math.max(countValue, 1)

f_record_sweep_event(int directionValue, string sourceValue, float levelPriceValue, float sweepExtremeValue, int confluenceValue, bool firstInteractionValue) =>
    bool merged = false
    if array.size(sweepEvents) > 0
        SweepEvent latestEvent = array.get(sweepEvents, array.size(sweepEvents) - 1)
        if latestEvent.direction == directionValue and latestEvent.sweepBar == bar_index
            latestEvent.source := str.contains(latestEvent.source, sourceValue) ? latestEvent.source : latestEvent.source + ", " + sourceValue
            latestEvent.confluenceCount := math.max(latestEvent.confluenceCount, confluenceValue)
            latestEvent.levelPrice := directionValue == DIR_BULL ? math.min(latestEvent.levelPrice, levelPriceValue) : math.max(latestEvent.levelPrice, levelPriceValue)
            latestEvent.sweepExtreme := directionValue == DIR_BULL ? math.min(latestEvent.sweepExtreme, sweepExtremeValue) : math.max(latestEvent.sweepExtreme, sweepExtremeValue)
            merged := true
    if not merged
        SweepEvent newEvent = SweepEvent.new(
             id = f_new_id(directionValue == DIR_BULL ? "SWEEP-BULL" : "SWEEP-BEAR", time, bar_index),
             direction = directionValue,
             source = sourceValue,
             levelPrice = levelPriceValue,
             sweepExtreme = sweepExtremeValue,
             sweepTime = time,
             sweepBar = bar_index,
             reclaimTime = time,
             reclaimBar = bar_index,
             confluenceCount = confluenceValue,
             firstInteraction = firstInteractionValue,
             expiryBar = bar_index + setupWindowBars)
        array.push(sweepEvents, newEvent)

f_recent_sweep_index(int directionValue) =>
    int resultIndex = -1
    if array.size(sweepEvents) > 0
        for i = array.size(sweepEvents) - 1 to 0
            SweepEvent eventValue = array.get(sweepEvents, i)
            if eventValue.direction == directionValue and bar_index <= eventValue.expiryBar
                resultIndex := i
                break
    resultIndex

f_zone_exists(string zoneTypeValue, int directionValue, float topValue, float bottomValue) =>
    bool exists = false
    if array.size(setupZones) > 0
        for i = 0 to array.size(setupZones) - 1
            SetupZone zoneValue = array.get(setupZones, i)
            if zoneValue.zoneType == zoneTypeValue and zoneValue.direction == directionValue and not f_state_terminal_zone(zoneValue.state) and math.abs(zoneValue.top - topValue) <= syminfo.mintick and math.abs(zoneValue.bottom - bottomValue) <= syminfo.mintick
                exists := true
                break
    exists

f_create_zone(string zoneTypeValue, int directionValue, float topValue, float bottomValue, int originTimeValue, int originBarValue, int structuralLegValue, bool originDisplacementValue) =>
    float normalizedTop = math.max(topValue, bottomValue)
    float normalizedBottom = math.min(topValue, bottomValue)
    if indicatorEnabled and normalizedTop > normalizedBottom and not f_zone_exists(zoneTypeValue, directionValue, normalizedTop, normalizedBottom)
        int lifeMinutesValue = f_zone_minutes(zoneTypeValue)
        SetupZone newZone = SetupZone.new(
             id = f_new_id(zoneTypeValue + (directionValue == DIR_BULL ? "-B" : "-S"), originTimeValue, originBarValue),
             zoneType = zoneTypeValue,
             direction = directionValue,
             top = normalizedTop,
             bottom = normalizedBottom,
             midpoint = (normalizedTop + normalizedBottom) * 0.5,
             originTime = originTimeValue,
             originBar = originBarValue,
             structuralLegId = structuralLegValue,
             state = Z_CANDIDATE,
             score = 0,
             scoreLiquidity = 0,
             scoreStructure = 0,
             scoreZone = 0,
             scoreHtf = 0,
             scoreSmt = 0,
             scoreSession = 0,
             scoreLocation = 0,
             scoreText = "",
             strategyName = "",
             strategyMatches = "",
             rejectionReason = "",
             touchCount = 0,
             fillPercent = 0.0,
             expiryTime = originTimeValue + lifeMinutesValue * 60 * 1000,
             qualifiedTime = na,
             armedTime = na,
             entryPendingBar = na,
             linkedSweepBar = na,
             linkedLiquidityPrice = na,
             linkedSweepExtreme = na,
             linkedLiquiditySource = "",
             structureType = "",
             originDisplacement = originDisplacementValue,
             transformed = false,
             failedBar = na,
             invalidationPrice = na,
             zoneBox = na,
             zoneLabel = na,
             midpointLine = na,
             sourceLine = na,
             sourceLabel = na)
        array.push(setupZones, newZone)

f_zone_overlap_confluence(SetupZone targetZone) =>
    bool overlaps = false
    if array.size(setupZones) > 0
        for i = 0 to array.size(setupZones) - 1
            SetupZone otherZone = array.get(setupZones, i)
            if otherZone.id != targetZone.id and otherZone.direction == targetZone.direction and not f_state_terminal_zone(otherZone.state)
                bool typePair = (targetZone.zoneType == "FVG" or targetZone.zoneType == "IFVG") != (otherZone.zoneType == "FVG" or otherZone.zoneType == "IFVG")
                bool priceOverlap = math.max(targetZone.bottom, otherZone.bottom) < math.min(targetZone.top, otherZone.top)
                if typePair and priceOverlap
                    overlaps := true
                    break
    overlaps

f_unicorn_overlap(SetupZone targetZone) =>
    bool overlaps = false
    bool targetIsGap = targetZone.zoneType == "FVG" or targetZone.zoneType == "IFVG"
    bool targetIsBreaker = targetZone.zoneType == "BB"
    if (targetIsGap or targetIsBreaker) and array.size(setupZones) > 0
        for i = 0 to array.size(setupZones) - 1
            SetupZone otherZone = array.get(setupZones, i)
            bool otherIsGap = otherZone.zoneType == "FVG" or otherZone.zoneType == "IFVG"
            bool otherIsBreaker = otherZone.zoneType == "BB"
            bool validPair = (targetIsGap and otherIsBreaker) or (targetIsBreaker and otherIsGap)
            bool priceOverlap = math.max(targetZone.bottom, otherZone.bottom) < math.min(targetZone.top, otherZone.top)
            if otherZone.id != targetZone.id and otherZone.direction == targetZone.direction and not f_state_terminal_zone(otherZone.state) and validPair and priceOverlap
                overlaps := true
                break
    overlaps

f_near_active_liquidity(float priceValue, float toleranceValue) =>
    bool nearby = false
    if array.size(liquidityLevels) > 0
        for i = 0 to array.size(liquidityLevels) - 1
            LiquidityLevel levelValue = array.get(liquidityLevels, i)
            if levelValue.state != LIQ_ACCEPTED and levelValue.state != LIQ_EXPIRED and math.abs(levelValue.price - priceValue) <= toleranceValue
                nearby := true
                break
    nearby

f_has_opposing_liquidity(int directionValue, float referencePrice) =>
    bool foundValue = false
    if array.size(liquidityLevels) > 0
        for i = 0 to array.size(liquidityLevels) - 1
            LiquidityLevel levelValue = array.get(liquidityLevels, i)
            bool validState = levelValue.state != LIQ_ACCEPTED and levelValue.state != LIQ_EXPIRED
            if validState and ((directionValue == DIR_BULL and levelValue.side == DIR_BULL and levelValue.price > referencePrice) or (directionValue == DIR_BEAR and levelValue.side == DIR_BEAR and levelValue.price < referencePrice))
                foundValue := true
                break
    foundValue

f_active_trade_count() =>
    int countValue = 0
    if array.size(trades) > 0
        for i = 0 to array.size(trades) - 1
            TradeHypothesis tradeValue = array.get(trades, i)
            if not f_state_terminal_trade(tradeValue.state)
                countValue += 1
    countValue

f_visible_trade_limit() =>
    maximumVisibleTrades

f_concept_allowed(string zoneTypeValue) =>
    conceptSelection == "All" or conceptSelection == zoneTypeValue

f_strategy_entry_mode(string strategyNameValue) =>
    strategyNameValue == "Unicorn Model" or strategyNameValue == "Silver Bullet" ? "Consequent encroachment" : "Confirmed rejection close"

f_auto_max_stop_ticks() =>
    string localRoot = str.upper(syminfo.root)
    bool localNq = localRoot == "NQ" or localRoot == "MNQ"
    bool localEs = localRoot == "ES" or localRoot == "MES"
    localNq ? 32 : localEs ? 12 : 32

f_stop_is_valid(int directionValue, float entryPriceValue, float stopPriceValue, float atrValue) =>
    float riskValue = math.abs(entryPriceValue - stopPriceValue)
    float riskTicks = riskValue / syminfo.mintick
    float riskAtr = not na(atrValue) and atrValue > 0 ? riskValue / atrValue : na
    int maxTicksValue = stopLimitMode == "Automatic" ? f_auto_max_stop_ticks() : maximumStopTicksCustom
    bool correctSide = directionValue == DIR_BULL ? stopPriceValue < entryPriceValue : stopPriceValue > entryPriceValue
    bool tickPass = stopLimitMode == "Off" or (riskTicks >= minimumStopTicks and riskTicks <= maxTicksValue)
    bool atrPass = stopLimitMode == "Off" or na(riskAtr) or riskAtr <= maximumStopAtr
    correctSide and riskValue > syminfo.mintick and tickPass and atrPass

f_set_trade_end(TradeHypothesis tradeValue, int endTimeValue) =>
    int safeEndTime = math.max(endTimeValue, tradeValue.entryTime)
    if not na(tradeValue.zoneBox)
        box.set_right(tradeValue.zoneBox, safeEndTime)
    if not na(tradeValue.riskBox)
        box.set_right(tradeValue.riskBox, safeEndTime)
    if not na(tradeValue.reward1Box)
        box.set_right(tradeValue.reward1Box, safeEndTime)
    if not na(tradeValue.reward15Box)
        box.set_right(tradeValue.reward15Box, safeEndTime)
    if not na(tradeValue.reward2Box)
        box.set_right(tradeValue.reward2Box, safeEndTime)
    if not na(tradeValue.entryLine)
        line.set_x2(tradeValue.entryLine, safeEndTime)
    if not na(tradeValue.stopLine)
        line.set_x2(tradeValue.stopLine, safeEndTime)
    if not na(tradeValue.target1Line)
        line.set_x2(tradeValue.target1Line, safeEndTime)
    if not na(tradeValue.target15Line)
        line.set_x2(tradeValue.target15Line, safeEndTime)
    if not na(tradeValue.target2Line)
        line.set_x2(tradeValue.target2Line, safeEndTime)
    if not na(tradeValue.stopLabel)
        label.set_x(tradeValue.stopLabel, safeEndTime)
    if not na(tradeValue.target1Label)
        label.set_x(tradeValue.target1Label, safeEndTime)
    if not na(tradeValue.target15Label)
        label.set_x(tradeValue.target15Label, safeEndTime)
    if not na(tradeValue.target2Label)
        label.set_x(tradeValue.target2Label, safeEndTime)

f_fade_trade_drawings(TradeHypothesis tradeValue) =>
    if not na(tradeValue.zoneBox)
        box.set_bgcolor(tradeValue.zoneBox, color.new(neutralColor, historicalTradeTransparency))
        box.set_border_color(tradeValue.zoneBox, color.new(neutralColor, 100))
    if not na(tradeValue.riskBox)
        box.set_bgcolor(tradeValue.riskBox, color.new(riskZoneColor, historicalTradeTransparency))
        box.set_border_color(tradeValue.riskBox, color.new(riskZoneColor, 100))
    if not na(tradeValue.reward1Box)
        box.set_bgcolor(tradeValue.reward1Box, color.new(rewardZoneColor, historicalTradeTransparency))
        box.set_border_color(tradeValue.reward1Box, color.new(rewardZoneColor, 100))
    if not na(tradeValue.reward15Box)
        box.set_bgcolor(tradeValue.reward15Box, color.new(rewardZoneColor, historicalTradeTransparency))
        box.set_border_color(tradeValue.reward15Box, color.new(rewardZoneColor, 100))
    if not na(tradeValue.reward2Box)
        box.set_bgcolor(tradeValue.reward2Box, color.new(rewardZoneColor, historicalTradeTransparency))
        box.set_border_color(tradeValue.reward2Box, color.new(rewardZoneColor, 100))
    if not na(tradeValue.stopLine)
        line.set_color(tradeValue.stopLine, color.new(stopLineColor, 58))
    if not na(tradeValue.target1Line)
        line.set_color(tradeValue.target1Line, color.new(targetLineColor, 62))
    if not na(tradeValue.target15Line)
        line.set_color(tradeValue.target15Line, color.new(targetLineColor, 68))
    if not na(tradeValue.target2Line)
        line.set_color(tradeValue.target2Line, color.new(targetLineColor, 72))
    if not na(tradeValue.signalLabel)
        label.set_color(tradeValue.signalLabel, color.new(tradeValue.direction == DIR_BULL ? bullishSignalColor : bearishSignalColor, 72))
    if not na(tradeValue.stopLabel)
        label.set_textcolor(tradeValue.stopLabel, color.new(stopLineColor, 52))
    if not na(tradeValue.target1Label)
        label.set_textcolor(tradeValue.target1Label, color.new(targetLineColor, 55))
    if not na(tradeValue.target15Label)
        label.set_textcolor(tradeValue.target15Label, color.new(targetLineColor, 62))
    if not na(tradeValue.target2Label)
        label.set_textcolor(tradeValue.target2Label, color.new(targetLineColor, 67))

f_send_json(string eventName, string eventId, int directionValue, string zoneTypeValue, int scoreValue, float priceValue, string detailValue) =>
    if enableAlerts and enableJsonAlerts
        string payload = "{" +
             "\"schema\":\"meridian.futures_setups.event.v2\"," +
             "\"version\":\"" + VERSION + "\"," +
             "\"event\":\"" + f_json_safe(eventName) + "\"," +
             "\"event_id\":\"" + f_json_safe(eventId) + "\"," +
             "\"symbol\":\"" + f_json_safe(syminfo.tickerid) + "\"," +
             "\"timeframe\":\"" + f_json_safe(timeframe.period) + "\"," +
             "\"direction\":\"" + f_direction_text(directionValue) + "\"," +
             "\"zone_type\":\"" + f_json_safe(zoneTypeValue) + "\"," +
             "\"score\":" + str.tostring(scoreValue) + "," +
             "\"price\":" + str.tostring(priceValue, format.mintick) + "," +
             "\"time\":" + str.tostring(time) + "," +
             "\"detail\":\"" + f_json_safe(detailValue) + "\"}"
        alert(payload, alert.freq_once_per_bar_close)

// ─────────────────────────────────────────────────────────────────────────────
// Phase 1 — Market, session, HTF, and liquidity foundations
// ─────────────────────────────────────────────────────────────────────────────
string rootSymbol = str.upper(syminfo.root)
bool chartIsNq = rootSymbol == "NQ" or rootSymbol == "MNQ"
bool chartIsEs = rootSymbol == "ES" or rootSymbol == "MES"
bool supportedSymbol = chartIsNq or chartIsEs
float timeframeSeconds = timeframe.in_seconds()
int timeframeMinutes = timeframe.isintraday ? int(math.round(timeframeSeconds / 60.0)) : 0
bool supportedTimeframe = timeframe.isintraday and (timeframeMinutes == 1 or timeframeMinutes == 3 or timeframeMinutes == 5 or timeframeMinutes == 15)
bool engineSupported = (supportedSymbol or allowUnsupportedSymbols) and supportedTimeframe

bool inFutures = f_in_session(futuresSession)
bool inOvernight = f_in_session(overnightSession)
bool inRth = f_in_session(rthSession)
bool inMorning = f_in_session(morningWindow)
bool inAfternoon = enableAfternoonWindow and f_in_session(afternoonWindow)
bool qualificationWindow = inMorning or inAfternoon
bool inSilverBulletLondon = silverBulletLondonEnabled and f_in_session(silverBulletLondonWindow)
bool inSilverBulletMorning = silverBulletMorningEnabled and f_in_session(silverBulletMorningWindow)
bool inSilverBulletAfternoon = silverBulletAfternoonEnabled and f_in_session(silverBulletAfternoonWindow)
bool inSilverBulletWindow = inSilverBulletLondon or inSilverBulletMorning or inSilverBulletAfternoon
int dateKey = f_date_key()
bool newRth = inRth and (not inRth[1] or dateKey != dateKey[1])
bool endRth = not inRth and inRth[1]
bool newOvernight = inOvernight and not inOvernight[1]

float atr = ta.atr(atrLength)
float penetrationThreshold = math.max(minimumPenetrationTicks * syminfo.mintick, nz(atr) * minimumPenetrationAtr)
float clusterTolerance = math.max(syminfo.mintick * 2.0, nz(atr) * liquidityClusterAtr)

// Confirmed higher-timeframe values. The [1] offset with lookahead_on returns
// the last completed HTF bar throughout the current HTF bar.
[pdh, pdl, pdTime] = request.security(syminfo.tickerid, "1D", [high[1], low[1], time[1]], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
[pwh, pwl, pwTime] = request.security(syminfo.tickerid, "1W", [high[1], low[1], time[1]], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
[h15, l15, t15] = request.security(syminfo.tickerid, "15", [high[1], low[1], time[1]], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
[h60, l60, t60] = request.security(syminfo.tickerid, "60", [high[1], low[1], time[1]], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
[h240, l240, t240, c240, ema240] = request.security(syminfo.tickerid, "240", [high[1], low[1], time[1], close[1], ta.ema(close, 20)[1]], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
[hDay, lDay, tDay, cDay, emaDay] = request.security(syminfo.tickerid, "1D", [high[1], low[1], time[1], close[1], ta.ema(close, 20)[1]], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)

var float lastPdh = na
var float lastPdl = na
var float lastPwh = na
var float lastPwl = na
var float lastH15 = na
var float lastL15 = na
var float lastH60 = na
var float lastL60 = na
var float lastH240 = na
var float lastL240 = na
var float lastHDay = na
var float lastLDay = na

if barstate.isconfirmed and engineSupported
    if usePriorDay and (na(lastPdh) or pdh != lastPdh)
        f_register_liquidity("PDH", "1D", pdh, pdTime, bar_index, DIR_BULL)
        lastPdh := pdh
    if usePriorDay and (na(lastPdl) or pdl != lastPdl)
        f_register_liquidity("PDL", "1D", pdl, pdTime, bar_index, DIR_BEAR)
        lastPdl := pdl
    if usePriorWeek and (na(lastPwh) or pwh != lastPwh)
        f_register_liquidity("PWH", "1W", pwh, pwTime, bar_index, DIR_BULL)
        lastPwh := pwh
    if usePriorWeek and (na(lastPwl) or pwl != lastPwl)
        f_register_liquidity("PWL", "1W", pwl, pwTime, bar_index, DIR_BEAR)
        lastPwl := pwl
    if useConfirmedHtfLevels
        if na(lastH15) or h15 != lastH15
            f_register_liquidity("15m HIGH", "15", h15, t15, bar_index, DIR_BULL)
            lastH15 := h15
        if na(lastL15) or l15 != lastL15
            f_register_liquidity("15m LOW", "15", l15, t15, bar_index, DIR_BEAR)
            lastL15 := l15
        if na(lastH60) or h60 != lastH60
            f_register_liquidity("1H HIGH", "60", h60, t60, bar_index, DIR_BULL)
            lastH60 := h60
        if na(lastL60) or l60 != lastL60
            f_register_liquidity("1H LOW", "60", l60, t60, bar_index, DIR_BEAR)
            lastL60 := l60
        if na(lastH240) or h240 != lastH240
            f_register_liquidity("4H HIGH", "240", h240, t240, bar_index, DIR_BULL)
            lastH240 := h240
        if na(lastL240) or l240 != lastL240
            f_register_liquidity("4H LOW", "240", l240, t240, bar_index, DIR_BEAR)
            lastL240 := l240
        if na(lastHDay) or hDay != lastHDay
            f_register_liquidity("DAILY HIGH", "1D", hDay, tDay, bar_index, DIR_BULL)
            lastHDay := hDay
        if na(lastLDay) or lDay != lastLDay
            f_register_liquidity("DAILY LOW", "1D", lDay, tDay, bar_index, DIR_BEAR)
            lastLDay := lDay

// Developing session references.
var float overnightHigh = na
var float overnightLow = na
var int overnightStartTime = na
var float orHigh = na
var float orLow = na
var bool orRegistered = false
var float ibHigh = na
var float ibLow = na
var bool ibRegistered = false

if newOvernight
    overnightHigh := high
    overnightLow := low
    overnightStartTime := time
else if inOvernight
    overnightHigh := na(overnightHigh) ? high : math.max(overnightHigh, high)
    overnightLow := na(overnightLow) ? low : math.min(overnightLow, low)

bool inOpeningRange = inRth and f_window_active(9, 30, openingRangeMinutes)
bool inInitialBalance = inRth and f_window_active(9, 30, initialBalanceMinutes)

if newRth
    if useOvernight and not na(overnightHigh) and not na(overnightLow)
        f_register_liquidity("ONH", "RTH", overnightHigh, overnightStartTime, bar_index, DIR_BULL)
        f_register_liquidity("ONL", "RTH", overnightLow, overnightStartTime, bar_index, DIR_BEAR)
    orHigh := high
    orLow := low
    orRegistered := false
    ibHigh := high
    ibLow := low
    ibRegistered := false
else
    if inOpeningRange
        orHigh := na(orHigh) ? high : math.max(orHigh, high)
        orLow := na(orLow) ? low : math.min(orLow, low)
    if inInitialBalance
        ibHigh := na(ibHigh) ? high : math.max(ibHigh, high)
        ibLow := na(ibLow) ? low : math.min(ibLow, low)

if barstate.isconfirmed and inRth and not inOpeningRange and not orRegistered and not na(orHigh)
    if useOpeningRange
        f_register_liquidity("ORH", "RTH", orHigh, time, bar_index, DIR_BULL)
        f_register_liquidity("ORL", "RTH", orLow, time, bar_index, DIR_BEAR)
    orRegistered := true

if barstate.isconfirmed and inRth and not inInitialBalance and not ibRegistered and not na(ibHigh)
    if useInitialBalance
        f_register_liquidity("IBH", "RTH", ibHigh, time, bar_index, DIR_BULL)
        f_register_liquidity("IBL", "RTH", ibLow, time, bar_index, DIR_BEAR)
    ibRegistered := true

// Confirmed chart pivots and dealing range.
float pivotHighValue = ta.pivothigh(high, pivotLeft, pivotRight)
float pivotLowValue = ta.pivotlow(low, pivotLeft, pivotRight)
var float previousSwingHigh = na
var float latestSwingHigh = na
var int latestSwingHighBar = na
var float previousSwingLow = na
var float latestSwingLow = na
var int latestSwingLowBar = na
var int lastBrokenHighBar = na
var int lastBrokenLowBar = na

if barstate.isconfirmed and not na(pivotHighValue)
    previousSwingHigh := latestSwingHigh
    latestSwingHigh := pivotHighValue
    latestSwingHighBar := bar_index - pivotRight
    if useChartPivots
        f_register_liquidity("SWING HIGH", timeframe.period, pivotHighValue, time[pivotRight], latestSwingHighBar, DIR_BULL)

if barstate.isconfirmed and not na(pivotLowValue)
    previousSwingLow := latestSwingLow
    latestSwingLow := pivotLowValue
    latestSwingLowBar := bar_index - pivotRight
    if useChartPivots
        f_register_liquidity("SWING LOW", timeframe.period, pivotLowValue, time[pivotRight], latestSwingLowBar, DIR_BEAR)

float dealingHigh = latestSwingHigh
float dealingLow = latestSwingLow
float dealingMidpoint = not na(dealingHigh) and not na(dealingLow) ? (dealingHigh + dealingLow) * 0.5 : na

// Same-time-of-day RVOL baseline. Current values are compared before the
// confirmed bar is committed to its circular slot history.
int rthStartTimestamp = timestamp(sessionTimezone, year(time, sessionTimezone), month(time, sessionTimezone), dayofmonth(time, sessionTimezone), 9, 30)
int timeframeMilliseconds = timeframeMinutes > 0 ? timeframeMinutes * 60 * 1000 : 0
int currentRthSlot = inRth and timeframeMilliseconds > 0 ? int(math.floor((time - rthStartTimestamp) / timeframeMilliseconds)) : -1
bool validRthSlot = currentRthSlot >= 0 and currentRthSlot < MAX_RTH_SLOTS
var float[] slotVolumeHistory = array.new_float(MAX_RTH_SLOTS * rvolBaselineSessions, na)
var float[] slotVolumeSums = array.new_float(MAX_RTH_SLOTS, 0.0)
var int[] slotVolumeCounts = array.new_int(MAX_RTH_SLOTS, 0)
var int[] slotWriteIndices = array.new_int(MAX_RTH_SLOTS, 0)
int rvolSamples = validRthSlot ? array.get(slotVolumeCounts, currentRthSlot) : 0
float rvolAverage = validRthSlot and rvolSamples > 0 ? array.get(slotVolumeSums, currentRthSlot) / rvolSamples : na
float sameTimeRvol = inRth and rvolSamples >= rvolMinimumSamples ? f_safe_ratio(nz(volume), rvolAverage) : na

if barstate.isconfirmed and inRth and validRthSlot
    int slotWrite = array.get(slotWriteIndices, currentRthSlot)
    int flatIndex = currentRthSlot * rvolBaselineSessions + slotWrite
    int existingSamples = array.get(slotVolumeCounts, currentRthSlot)
    float oldVolume = array.get(slotVolumeHistory, flatIndex)
    float currentVolume = nz(volume)
    if existingSamples < rvolBaselineSessions
        array.set(slotVolumeHistory, flatIndex, currentVolume)
        array.set(slotVolumeSums, currentRthSlot, array.get(slotVolumeSums, currentRthSlot) + currentVolume)
        array.set(slotVolumeCounts, currentRthSlot, existingSamples + 1)
    else
        array.set(slotVolumeHistory, flatIndex, currentVolume)
        array.set(slotVolumeSums, currentRthSlot, array.get(slotVolumeSums, currentRthSlot) - nz(oldVolume) + currentVolume)
    array.set(slotWriteIndices, currentRthSlot, (slotWrite + 1) % rvolBaselineSessions)

// Realized-volatility context used only as one small scoring component.
float logReturn = close > 0 and close[1] > 0 ? math.log(close / close[1]) : 0.0
float realizedVol = math.sqrt(math.max(ta.sma(logReturn * logReturn, 20) * 20, 0.0))
float realizedVolBase = ta.ema(realizedVol, 50)
float realizedVolRatio = f_safe_ratio(realizedVol, realizedVolBase)

// Process liquidity lifecycles on confirmed bars.
if barstate.isconfirmed and engineSupported and array.size(liquidityLevels) > 0
    for i = array.size(liquidityLevels) - 1 to 0
        LiquidityLevel levelValue = array.get(liquidityLevels, i)
        if time > levelValue.expiryTime and levelValue.state != LIQ_RECLAIMED and levelValue.state != LIQ_ACCEPTED
            levelValue.state := LIQ_EXPIRED
        if levelValue.state == LIQ_ACTIVE or levelValue.state == LIQ_TOUCHED or levelValue.state == LIQ_PENETRATED
            bool touchedNow = levelValue.side == DIR_BULL ? high >= levelValue.price : low <= levelValue.price
            float penetrationValue = levelValue.side == DIR_BULL ? high - levelValue.price : levelValue.price - low
            bool penetratedNow = penetrationValue >= penetrationThreshold
            bool originalSideClose = levelValue.side == DIR_BULL ? close < levelValue.price : close > levelValue.price
            bool beyondClose = levelValue.side == DIR_BULL ? close > levelValue.price : close < levelValue.price
            if touchedNow and levelValue.state == LIQ_ACTIVE
                levelValue.state := LIQ_TOUCHED
                levelValue.testCount += 1
            if penetratedNow
                levelValue.maxPenetrationTicks := math.max(levelValue.maxPenetrationTicks, penetrationValue / syminfo.mintick)
                if na(levelValue.penetrationBar)
                    levelValue.penetrationBar := bar_index
                    levelValue.beyondCloses := 0
                levelValue.state := LIQ_PENETRATED
                if originalSideClose
                    int eventDirection = levelValue.side == DIR_BULL ? DIR_BEAR : DIR_BULL
                    int confluenceValue = f_count_liquidity_confluence(levelValue.price, levelValue.side, clusterTolerance)
                    f_record_sweep_event(eventDirection, levelValue.source, levelValue.price, eventDirection == DIR_BULL ? low : high, confluenceValue, levelValue.testCount <= 1)
                    levelValue.state := LIQ_RECLAIMED
                else if beyondClose
                    levelValue.beyondCloses += 1
            else if levelValue.state == LIQ_PENETRATED and not na(levelValue.penetrationBar)
                if originalSideClose and bar_index - levelValue.penetrationBar <= reclaimWindowBars
                    int eventDirection = levelValue.side == DIR_BULL ? DIR_BEAR : DIR_BULL
                    int confluenceValue = f_count_liquidity_confluence(levelValue.price, levelValue.side, clusterTolerance)
                    f_record_sweep_event(eventDirection, levelValue.source, levelValue.price, eventDirection == DIR_BULL ? low : high, confluenceValue, levelValue.testCount <= 1)
                    levelValue.state := LIQ_RECLAIMED
                else if beyondClose
                    levelValue.beyondCloses += 1
            if levelValue.state == LIQ_PENETRATED and levelValue.beyondCloses >= acceptanceCloses
                levelValue.state := LIQ_ACCEPTED
            if levelValue.state == LIQ_PENETRATED and not na(levelValue.penetrationBar) and bar_index - levelValue.penetrationBar > reclaimWindowBars and levelValue.beyondCloses < acceptanceCloses
                levelValue.state := LIQ_ACTIVE
                levelValue.penetrationBar := na
                levelValue.beyondCloses := 0

while array.size(liquidityLevels) > MAX_LIQUIDITY
    array.shift(liquidityLevels)
while array.size(sweepEvents) > MAX_SWEEP_EVENTS
    array.shift(sweepEvents)

// ─────────────────────────────────────────────────────────────────────────────
// Phase 3 — Displacement, BOS, and MSS
// ─────────────────────────────────────────────────────────────────────────────
float candleRange = high - low
float candleBody = math.abs(close - open)
float bodyAtrRatio = not na(atr) and atr > 0 ? candleBody / atr : na
float bodyFraction = candleRange > 0 ? candleBody / candleRange : 0.0
float bullishCloseLocation = candleRange > 0 ? (close - low) / candleRange : 0.5
float bearishCloseLocation = candleRange > 0 ? (high - close) / candleRange : 0.5
bool bullishDisplacement = close > open and nz(bodyAtrRatio) >= displacementBodyAtr and bodyFraction >= displacementBodyFraction and bullishCloseLocation >= displacementCloseLocation
bool bearishDisplacement = close < open and nz(bodyAtrRatio) >= displacementBodyAtr and bodyFraction >= displacementBodyFraction and bearishCloseLocation >= displacementCloseLocation
float totalPath = ta.sma(math.abs(ta.change(close)), efficiencyLength) * efficiencyLength
float directionalEfficiency = not na(totalPath) and totalPath > 0 ? math.abs(close - close[efficiencyLength]) / totalPath : na

var int marketStructureDirection = DIR_NONE
var int structuralLegId = 0
var int lastBullStructureBar = na
var int lastBearStructureBar = na
var string lastBullStructureType = ""
var string lastBearStructureType = ""
var int lastBullDisplacementBar = na
var int lastBearDisplacementBar = na

if barstate.isconfirmed
    if bullishDisplacement
        lastBullDisplacementBar := bar_index
    if bearishDisplacement
        lastBearDisplacementBar := bar_index

bool bullStructureEvent = false
bool bearStructureEvent = false
string currentStructureType = ""
int currentStructureDirection = DIR_NONE

if barstate.isconfirmed and not na(latestSwingHigh) and close > latestSwingHigh and latestSwingHighBar != lastBrokenHighBar
    bool recentBullSweep = f_recent_sweep_index(DIR_BULL) >= 0
    currentStructureType := marketStructureDirection == DIR_BEAR or recentBullSweep ? "MSS" : "BOS"
    currentStructureDirection := DIR_BULL
    bullStructureEvent := true
    marketStructureDirection := DIR_BULL
    structuralLegId += 1
    lastBullStructureBar := bar_index
    lastBullStructureType := currentStructureType
    lastBrokenHighBar := latestSwingHighBar

if barstate.isconfirmed and not na(latestSwingLow) and close < latestSwingLow and latestSwingLowBar != lastBrokenLowBar
    bool recentBearSweep = f_recent_sweep_index(DIR_BEAR) >= 0
    currentStructureType := marketStructureDirection == DIR_BULL or recentBearSweep ? "MSS" : "BOS"
    currentStructureDirection := DIR_BEAR
    bearStructureEvent := true
    marketStructureDirection := DIR_BEAR
    structuralLegId += 1
    lastBearStructureBar := bar_index
    lastBearStructureType := currentStructureType
    lastBrokenLowBar := latestSwingLowBar

// ─────────────────────────────────────────────────────────────────────────────
// Phase 2 — FVG and IFVG lifecycle
// ─────────────────────────────────────────────────────────────────────────────
bool newBullFvg = barstate.isconfirmed and enableFvg and low > high[2]
bool newBearFvg = barstate.isconfirmed and enableFvg and high < low[2]
if newBullFvg
    f_create_zone("FVG", DIR_BULL, low, high[2], time, bar_index, structuralLegId, bullishDisplacement)
if newBearFvg
    f_create_zone("FVG", DIR_BEAR, low[2], high, time, bar_index, structuralLegId, bearishDisplacement)

// Inversion requires a confirmed close through the far boundary.
if barstate.isconfirmed and enableIfvg and array.size(setupZones) > 0
    int originalZoneCount = array.size(setupZones)
    for i = originalZoneCount - 1 to 0
        SetupZone zoneValue = array.get(setupZones, i)
        if zoneValue.zoneType == "FVG" and not zoneValue.transformed and zoneValue.state < Z_TRIGGERED
            bool inversion = zoneValue.direction == DIR_BULL ? close < zoneValue.bottom : close > zoneValue.top
            if inversion
                zoneValue.state := Z_INVERTED
                zoneValue.transformed := true
                f_delete_zone_drawings(zoneValue)
                f_create_zone("IFVG", -zoneValue.direction, zoneValue.top, zoneValue.bottom, time, bar_index, structuralLegId, zoneValue.direction == DIR_BULL ? bearishDisplacement : bullishDisplacement)

// ─────────────────────────────────────────────────────────────────────────────
// Phase 4 — Validated OB and BB construction
// ─────────────────────────────────────────────────────────────────────────────
f_find_opposing_candle(int directionValue) =>
    int foundOffset = na
    for lookback = 1 to obSearchBars
        bool opposing = directionValue == DIR_BULL ? close[lookback] < open[lookback] : close[lookback] > open[lookback]
        if opposing
            foundOffset := lookback
            break
    foundOffset

if barstate.isconfirmed and enableOb and currentStructureDirection != DIR_NONE
    bool matchingDisplacement = currentStructureDirection == DIR_BULL ? bullishDisplacement or bar_index - nz(lastBullDisplacementBar, -100000) <= displacementWindowBars : bearishDisplacement or bar_index - nz(lastBearDisplacementBar, -100000) <= displacementWindowBars
    if matchingDisplacement
        int opposingOffset = f_find_opposing_candle(currentStructureDirection)
        if not na(opposingOffset)
            float obTop = obGeometry == "Body" ? math.max(open[opposingOffset], close[opposingOffset]) : high[opposingOffset]
            float obBottom = obGeometry == "Body" ? math.min(open[opposingOffset], close[opposingOffset]) : low[opposingOffset]
            f_create_zone("OB", currentStructureDirection, obTop, obBottom, time[opposingOffset], bar_index - opposingOffset, structuralLegId, true)

// Detect OB failure. A later opposite structure event can transform it into a BB.
if barstate.isconfirmed and array.size(setupZones) > 0
    for i = array.size(setupZones) - 1 to 0
        SetupZone zoneValue = array.get(setupZones, i)
        if zoneValue.zoneType == "OB" and not zoneValue.transformed and zoneValue.state < Z_TRIGGERED
            bool failed = zoneValue.direction == DIR_BULL ? close < zoneValue.bottom : close > zoneValue.top
            if failed
                zoneValue.state := Z_INVALIDATED
                zoneValue.failedBar := bar_index
                f_delete_zone_drawings(zoneValue)
        if enableBb and zoneValue.zoneType == "OB" and zoneValue.state == Z_INVALIDATED and not zoneValue.transformed and not na(zoneValue.failedBar)
            bool oppositeStructure = currentStructureDirection == -zoneValue.direction and bar_index - zoneValue.failedBar <= bbConfirmationBars
            if oppositeStructure
                zoneValue.transformed := true
                f_create_zone("BB", -zoneValue.direction, zoneValue.top, zoneValue.bottom, time, bar_index, structuralLegId, true)

// ─────────────────────────────────────────────────────────────────────────────
// Phase 5 — Confirmed NQ / ES SMT divergence
// ─────────────────────────────────────────────────────────────────────────────
string automaticSmtSymbol = chartIsNq ? "CME_MINI:ES1!" : chartIsEs ? "CME_MINI:NQ1!" : manualSmtSymbol
string smtSymbol = useAutomaticSmtPair ? automaticSmtSymbol : manualSmtSymbol
[pairPivotHigh, pairPivotLow, pairAtr] = request.security(smtSymbol, timeframe.period, [ta.pivothigh(high, smtPivotLength, smtPivotLength), ta.pivotlow(low, smtPivotLength, smtPivotLength), ta.atr(atrLength)], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off, ignore_invalid_symbol = true)
float chartSmtHigh = ta.pivothigh(high, smtPivotLength, smtPivotLength)
float chartSmtLow = ta.pivotlow(low, smtPivotLength, smtPivotLength)
var float previousChartSmtHigh = na
var float latestChartSmtHigh = na
var int latestChartSmtHighBar = na
var float previousChartSmtLow = na
var float latestChartSmtLow = na
var int latestChartSmtLowBar = na
var float previousPairSmtHigh = na
var float latestPairSmtHigh = na
var int latestPairSmtHighBar = na
var float previousPairSmtLow = na
var float latestPairSmtLow = na
var int latestPairSmtLowBar = na
var int lastBullSmtBar = na
var int lastBearSmtBar = na

bool chartHighEvent = barstate.isconfirmed and not na(chartSmtHigh)
bool chartLowEvent = barstate.isconfirmed and not na(chartSmtLow)
bool pairHighEvent = barstate.isconfirmed and not na(pairPivotHigh)
bool pairLowEvent = barstate.isconfirmed and not na(pairPivotLow)

if chartHighEvent
    previousChartSmtHigh := latestChartSmtHigh
    latestChartSmtHigh := chartSmtHigh
    latestChartSmtHighBar := bar_index - smtPivotLength
if chartLowEvent
    previousChartSmtLow := latestChartSmtLow
    latestChartSmtLow := chartSmtLow
    latestChartSmtLowBar := bar_index - smtPivotLength
if pairHighEvent
    previousPairSmtHigh := latestPairSmtHigh
    latestPairSmtHigh := pairPivotHigh
    latestPairSmtHighBar := bar_index - smtPivotLength
if pairLowEvent
    previousPairSmtLow := latestPairSmtLow
    latestPairSmtLow := pairPivotLow
    latestPairSmtLowBar := bar_index - smtPivotLength

if enableSmt and engineSupported and barstate.isconfirmed
    bool pivotsNearHigh = not na(latestChartSmtHighBar) and not na(latestPairSmtHighBar) and math.abs(latestChartSmtHighBar - latestPairSmtHighBar) <= smtMaximumSeparation
    bool pivotsNearLow = not na(latestChartSmtLowBar) and not na(latestPairSmtLowBar) and math.abs(latestChartSmtLowBar - latestPairSmtLowBar) <= smtMaximumSeparation
    bool chartHigherHigh = not na(previousChartSmtHigh) and latestChartSmtHigh > previousChartSmtHigh + nz(atr) * smtMinimumDivergenceAtr
    bool pairHigherHigh = not na(previousPairSmtHigh) and latestPairSmtHigh > previousPairSmtHigh + nz(pairAtr) * smtMinimumDivergenceAtr
    bool chartLowerLow = not na(previousChartSmtLow) and latestChartSmtLow < previousChartSmtLow - nz(atr) * smtMinimumDivergenceAtr
    bool pairLowerLow = not na(previousPairSmtLow) and latestPairSmtLow < previousPairSmtLow - nz(pairAtr) * smtMinimumDivergenceAtr
    if pivotsNearHigh and ((chartHighEvent and chartHigherHigh and not pairHigherHigh) or (pairHighEvent and pairHigherHigh and not chartHigherHigh))
        lastBearSmtBar := bar_index
    if pivotsNearLow and ((chartLowEvent and chartLowerLow and not pairLowerLow) or (pairLowEvent and pairLowerLow and not chartLowerLow))
        lastBullSmtBar := bar_index

bool bullSmtRecent = enableSmt and not na(lastBullSmtBar) and bar_index - lastBullSmtBar <= smtValidityBars
bool bearSmtRecent = enableSmt and not na(lastBearSmtBar) and bar_index - lastBearSmtBar <= smtValidityBars

// ─────────────────────────────────────────────────────────────────────────────
// Phase 6 — Adjustable confluence scoring and hard gates
// ─────────────────────────────────────────────────────────────────────────────
bool htfBullAligned = c240 > ema240 and cDay > emaDay
bool htfBearAligned = c240 < ema240 and cDay < emaDay

f_score_zone(SetupZone zoneValue) =>
    int sweepIndex = f_recent_sweep_index(zoneValue.direction)
    bool hasSweep = sweepIndex >= 0
    SweepEvent linkedEvent = hasSweep ? array.get(sweepEvents, sweepIndex) : na
    int structureBar = zoneValue.direction == DIR_BULL ? nz(lastBullStructureBar, -100000) : nz(lastBearStructureBar, -100000)
    string structureName = zoneValue.direction == DIR_BULL ? lastBullStructureType : lastBearStructureType
    int displacementBar = zoneValue.direction == DIR_BULL ? nz(lastBullDisplacementBar, -100000) : nz(lastBearDisplacementBar, -100000)
    bool structureAfterSweep = hasSweep and structureBar >= linkedEvent.sweepBar and bar_index - structureBar <= setupWindowBars
    bool displacementAfterSweep = hasSweep and displacementBar >= linkedEvent.sweepBar and bar_index - displacementBar <= setupWindowBars
    bool validMss = structureAfterSweep and structureName == "MSS"
    bool validBos = structureAfterSweep and structureName == "BOS"
    bool validStructure = validMss or validBos
    bool validDisplacement = displacementAfterSweep or zoneValue.originDisplacement
    float zoneSizeAtr = not na(atr) and atr > 0 ? (zoneValue.top - zoneValue.bottom) / atr : na
    bool zoneSizePreferred = not na(zoneSizeAtr) and zoneSizeAtr >= minimumZoneAtr and zoneSizeAtr <= maximumZoneAtr
    bool overlapValue = f_zone_overlap_confluence(zoneValue)
    bool unicornOverlap = f_unicorn_overlap(zoneValue)
    bool htfAligned = zoneValue.direction == DIR_BULL ? htfBullAligned : htfBearAligned
    bool htfNearby = f_near_active_liquidity(zoneValue.midpoint, nz(atr) * 0.50)
    bool liquidityObjective = f_has_opposing_liquidity(zoneValue.direction, zoneValue.midpoint)
    bool smtAligned = zoneValue.direction == DIR_BULL ? bullSmtRecent : bearSmtRecent
    bool locationAligned = na(dealingMidpoint) ? false : zoneValue.direction == DIR_BULL ? zoneValue.midpoint < dealingMidpoint : zoneValue.midpoint > dealingMidpoint
    bool atEquilibrium = not na(dealingMidpoint) and math.abs(zoneValue.midpoint - dealingMidpoint) <= nz(atr) * 0.10
    bool conceptGate = f_concept_allowed(zoneValue.zoneType)

    float liquidityFraction = 0.0
    if hasSweep
        liquidityFraction += 15.0 / 20.0
        if linkedEvent.confluenceCount >= 2
            liquidityFraction += 5.0 / 20.0
        else if linkedEvent.firstInteraction
            liquidityFraction += 2.0 / 20.0
    liquidityFraction := f_clamp(liquidityFraction, 0.0, 1.0)

    float structureFraction = 0.0
    structureFraction += validMss ? 10.0 / 20.0 : validBos ? 8.0 / 20.0 : 0.0
    structureFraction += validDisplacement ? 5.0 / 20.0 : 0.0
    structureFraction += zoneValue.zoneType == "FVG" and zoneValue.originDisplacement ? 5.0 / 20.0 : 0.0
    structureFraction += nz(directionalEfficiency) >= efficiencyThreshold ? 3.0 / 20.0 : 0.0
    structureFraction := f_clamp(structureFraction, 0.0, 1.0)

    float zoneFraction = 0.0
    zoneFraction += zoneValue.touchCount == 0 ? 5.0 / 20.0 : 0.0
    zoneFraction += zoneSizePreferred ? 5.0 / 20.0 : 0.0
    zoneFraction += overlapValue ? 5.0 / 20.0 : 0.0
    zoneFraction += zoneValue.fillPercent <= 0.25 ? 3.0 / 20.0 : 0.0
    zoneFraction += zoneValue.structuralLegId == structuralLegId ? 3.0 / 20.0 : 0.0
    zoneFraction := f_clamp(zoneFraction, 0.0, 1.0)

    float htfFraction = 0.0
    htfFraction += htfAligned ? 8.0 / 15.0 : 0.0
    htfFraction += htfNearby ? 4.0 / 15.0 : 0.0
    htfFraction += liquidityObjective ? 3.0 / 15.0 : 0.0
    htfFraction := f_clamp(htfFraction, 0.0, 1.0)

    float smtFraction = smtAligned ? 1.0 : 0.0

    float sessionFraction = 0.0
    sessionFraction += (inMorning or inSilverBulletWindow) ? 4.0 / 10.0 : 0.0
    sessionFraction += nz(sameTimeRvol) >= elevatedRvol ? 4.0 / 10.0 : 0.0
    sessionFraction += nz(realizedVolRatio) >= 0.85 and nz(realizedVolRatio) <= 1.80 ? 2.0 / 10.0 : 0.0
    if inRth and not qualificationWindow
        sessionFraction -= 3.0 / 10.0
    sessionFraction := f_clamp(sessionFraction, 0.0, 1.0)

    float locationFraction = locationAligned ? 1.0 : atEquilibrium ? 0.4 : 0.0

    int liquidityPoints = int(math.round(liquidityFraction * weightLiquidity))
    int structurePoints = int(math.round(structureFraction * weightStructure))
    int zonePoints = int(math.round(zoneFraction * weightZone))
    int htfPoints = int(math.round(htfFraction * weightHtf))
    int smtPoints = int(math.round(smtFraction * weightSmt))
    int sessionPoints = int(math.round(sessionFraction * weightSession))
    int locationPoints = int(math.round(locationFraction * weightLocation))
    int totalWeight = weightLiquidity + weightStructure + weightZone + weightHtf + weightSmt + weightSession + weightLocation
    int rawPoints = liquidityPoints + structurePoints + zonePoints + htfPoints + smtPoints + sessionPoints + locationPoints
    int normalizedScore = totalWeight > 0 ? int(math.round(rawPoints * 100.0 / totalWeight)) : 0

    int profileMinimum = scoringProfile == "Strict" ? 75 : scoringProfile == "Balanced" ? 65 : scoringProfile == "Aggressive" ? 55 : scoringProfile == "Research" ? 0 : minimumScoreInput
    bool profileGates = scoringProfile == "Strict" ? hasSweep and validMss and validDisplacement and qualificationWindow : scoringProfile == "Balanced" ? hasSweep and validStructure and validDisplacement and qualificationWindow : scoringProfile == "Aggressive" ? hasSweep and validStructure and qualificationWindow : scoringProfile == "Research" ? true : (not customRequireSweep or hasSweep) and (not customRequireMss or validMss) and (not customRequireDisplacement or validDisplacement) and (not customRequireSmt or smtAligned) and (not customRequireSession or qualificationWindow)

    bool meridianChoiceMatch = engineSupported and conceptGate and zoneSizePreferred and profileGates and normalizedScore >= profileMinimum
    bool unicornMatch = engineSupported and conceptGate and zoneSizePreferred and hasSweep and validMss and validDisplacement and unicornOverlap and qualificationWindow and normalizedScore >= profileMinimum
    bool silverBulletMatch = engineSupported and conceptGate and zoneValue.zoneType == "FVG" and zoneValue.originDisplacement and zoneSizePreferred and hasSweep and validMss and validDisplacement and inSilverBulletWindow and normalizedScore >= profileMinimum
    bool customMatch = engineSupported and conceptGate and zoneSizePreferred and (not customRequireSweep or hasSweep) and (not customRequireMss or validMss) and (not customRequireDisplacement or validDisplacement) and (not customRequireSmt or smtAligned) and (not customRequireSession or qualificationWindow) and normalizedScore >= minimumScoreInput

    bool allMeridian = enableMeridianChoiceInAll and meridianChoiceMatch
    bool allUnicorn = enableUnicornInAll and unicornMatch
    bool allSilver = enableSilverBulletInAll and silverBulletMatch
    bool passed = strategyMode == "Meridian Choice" ? meridianChoiceMatch : strategyMode == "Unicorn Model" ? unicornMatch : strategyMode == "Silver Bullet" ? silverBulletMatch : strategyMode == "Custom Confluence" ? customMatch : allMeridian or allUnicorn or allSilver

    string strategyMatches = ""
    if strategyMode == "All Enabled"
        if allUnicorn
            strategyMatches := "Unicorn Model"
        if allSilver
            strategyMatches := strategyMatches == "" ? "Silver Bullet" : strategyMatches + ", Silver Bullet"
        if allMeridian
            strategyMatches := strategyMatches == "" ? "Meridian Choice" : strategyMatches + ", Meridian Choice"
    else if passed
        strategyMatches := strategyMode

    string primaryStrategy = strategyMode
    if strategyMode == "All Enabled"
        primaryStrategy := allUnicorn ? "Unicorn Model" : allSilver ? "Silver Bullet" : allMeridian ? "Meridian Choice" : "All Enabled"

    string rejectReason = not engineSupported ? "Unsupported symbol/timeframe" : not conceptGate ? "Concept family disabled" : strategyMode == "Unicorn Model" and not unicornOverlap ? "No BB/FVG overlap" : strategyMode == "Silver Bullet" and not inSilverBulletWindow ? "Outside Silver Bullet window" : strategyMode == "Silver Bullet" and zoneValue.zoneType != "FVG" ? "Silver Bullet requires fresh FVG" : strategyMode == "Custom Confluence" and not customMatch ? "Custom gates or score failed" : strategyMode == "Meridian Choice" and not meridianChoiceMatch ? "Meridian Choice gates or score failed" : strategyMode == "All Enabled" and not (allMeridian or allUnicorn or allSilver) ? "No enabled strategy matched" : not zoneSizePreferred ? "Zone size outside range" : normalizedScore < profileMinimum ? "Score below profile minimum" : "Strategy gates failed"
    string explanation = "Strategy " + primaryStrategy + " · L " + str.tostring(liquidityPoints) + "/" + str.tostring(weightLiquidity) + " · S " + str.tostring(structurePoints) + "/" + str.tostring(weightStructure) + " · Z " + str.tostring(zonePoints) + "/" + str.tostring(weightZone) + " · HTF " + str.tostring(htfPoints) + "/" + str.tostring(weightHtf) + " · SMT " + str.tostring(smtPoints) + "/" + str.tostring(weightSmt)
    [passed, normalizedScore, liquidityPoints, structurePoints, zonePoints, htfPoints, smtPoints, sessionPoints, locationPoints, explanation, rejectReason, sweepIndex, structureName, primaryStrategy, strategyMatches]

// Event flags for static alert conditions and diagnostics.
bool candidateEvent = false
bool entryEvent = false
bool targetEvent = false
bool stopEvent = false
bool expiryEvent = false
var int detectedCount = 0
var int qualifiedCount = 0
var int triggeredCount = 0
var int completedCount = 0
var int stoppedCount = 0
var int expiredCount = 0
var int latestQualifiedScore = na
var string latestResearchReason = ""

// Qualify and arm candidates. At most one armed zone per direction is visible
// by default. Replacement is deterministic and occurs before entry.
if barstate.isconfirmed and array.size(setupZones) > 0
    for i = array.size(setupZones) - 1 to 0
        SetupZone zoneValue = array.get(setupZones, i)
        bool untriggeredExpired = (zoneValue.state == Z_CANDIDATE or zoneValue.state == Z_UNQUALIFIED or zoneValue.state == Z_QUALIFIED) and (time > zoneValue.expiryTime or (expireAtRthClose and endRth))
        if untriggeredExpired
            zoneValue.state := Z_EXPIRED
            zoneValue.rejectionReason := "Time or session expiry"
            f_delete_zone_drawings(zoneValue)
            expiryEvent := true
            expiredCount += 1
        if zoneValue.state == Z_CANDIDATE or zoneValue.state == Z_UNQUALIFIED
            detectedCount += zoneValue.state == Z_CANDIDATE ? 1 : 0
            [passed, scoreValue, liqPts, structurePts, zonePts, htfPts, smtPts, sessionPts, locationPts, explanation, rejectReason, sweepIndex, structureName, primaryStrategy, strategyMatches] = f_score_zone(zoneValue)
            zoneValue.score := scoreValue
            zoneValue.scoreLiquidity := liqPts
            zoneValue.scoreStructure := structurePts
            zoneValue.scoreZone := zonePts
            zoneValue.scoreHtf := htfPts
            zoneValue.scoreSmt := smtPts
            zoneValue.scoreSession := sessionPts
            zoneValue.scoreLocation := locationPts
            zoneValue.scoreText := explanation
            zoneValue.strategyName := primaryStrategy
            zoneValue.strategyMatches := strategyMatches
            zoneValue.rejectionReason := rejectReason
            if passed
                SweepEvent linkedEvent = array.get(sweepEvents, sweepIndex)
                zoneValue.linkedSweepBar := linkedEvent.sweepBar
                zoneValue.linkedLiquidityPrice := linkedEvent.levelPrice
                zoneValue.linkedSweepExtreme := linkedEvent.sweepExtreme
                zoneValue.linkedLiquiditySource := linkedEvent.source
                zoneValue.structureType := structureName
                zoneValue.qualifiedTime := time
                zoneValue.state := Z_QUALIFIED
                qualifiedCount += 1
                latestQualifiedScore := scoreValue
                latestResearchReason := "Qualified " + zoneValue.zoneType
            else
                zoneValue.state := Z_UNQUALIFIED
                latestResearchReason := rejectReason

        if zoneValue.state == Z_QUALIFIED
            bool replacementAllowed = true
            if array.size(setupZones) > 1
                for j = 0 to array.size(setupZones) - 1
                    SetupZone existingZone = array.get(setupZones, j)
                    if existingZone.id != zoneValue.id and existingZone.direction == zoneValue.direction and existingZone.state == Z_ARMED
                        bool replaceValue = replacementMode == "Off" ? false : replacementMode == "Higher score only" ? zoneValue.score >= existingZone.score + replacementScoreMargin : replacementMode == "Nearest qualified zone" ? math.abs(close - zoneValue.midpoint) < math.abs(close - existingZone.midpoint) : zoneValue.structuralLegId == existingZone.structuralLegId and zoneValue.score >= existingZone.score + replacementScoreMargin
                        if replaceValue
                            existingZone.state := Z_SUPERSEDED
                            f_delete_zone_drawings(existingZone)
                            expiryEvent := true
                            if enableAlerts and alertExpiry
                                f_send_json("setup_superseded", existingZone.id, existingZone.direction, existingZone.zoneType, existingZone.score, existingZone.midpoint, "Replaced by " + zoneValue.id)
                        else
                            replacementAllowed := false
            if replacementAllowed
                zoneValue.state := Z_ARMED
                zoneValue.armedTime := time
                candidateEvent := true
                if enableAlerts and alertCandidate
                    f_send_json("candidate_armed", zoneValue.id, zoneValue.direction, zoneValue.zoneType, zoneValue.score, zoneValue.midpoint, zoneValue.scoreText)

// ─────────────────────────────────────────────────────────────────────────────
// Visual creation for armed zones
// ─────────────────────────────────────────────────────────────────────────────
f_should_show_zone(SetupZone zoneValue) =>
    displayMode == "All Concepts" or displayMode == "Research" or displayMode == "Qualified Zones" or (displayMode == "Minimal" and zoneValue.state == Z_ARMED) or (displayMode == "Signals" and zoneValue.state >= Z_TRIGGERED)

if barstate.islast and array.size(setupZones) > 0
    for i = 0 to array.size(setupZones) - 1
        SetupZone zoneValue = array.get(setupZones, i)
        bool visibleZone = f_should_show_zone(zoneValue) and (zoneValue.state == Z_ARMED or zoneValue.state == Z_QUALIFIED or (displayMode == "All Concepts" and zoneValue.state == Z_UNQUALIFIED))
        if visibleZone
            color directionColor = zoneValue.direction == DIR_BULL ? bullishZoneColor : bearishZoneColor
            color zoneBackground = color.new(directionColor, zoneValue.state == Z_ARMED ? armedZoneTransparency : math.min(armedZoneTransparency + 7, 100))
            color borderValue = showZoneBorder ? color.new(directionColor, 25) : color.new(directionColor, 100)
            if na(zoneValue.zoneBox)
                zoneValue.zoneBox := box.new(left = zoneValue.originTime, top = zoneValue.top, right = zoneValue.expiryTime, bottom = zoneValue.bottom, xloc = xloc.bar_time, border_color = borderValue, bgcolor = zoneBackground)
            else
                box.set_lefttop(zoneValue.zoneBox, zoneValue.originTime, zoneValue.top)
                box.set_rightbottom(zoneValue.zoneBox, zoneValue.expiryTime, zoneValue.bottom)
                box.set_bgcolor(zoneValue.zoneBox, zoneBackground)
                box.set_border_color(zoneValue.zoneBox, borderValue)
            string zoneTagText = (zoneValue.strategyName == "" ? zoneValue.zoneType : zoneValue.strategyName) + (showZoneScore ? " · " + str.tostring(zoneValue.score) : "")
            if na(zoneValue.zoneLabel)
                zoneValue.zoneLabel := label.new(x = zoneValue.expiryTime, y = zoneValue.midpoint, text = zoneTagText, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(directionColor, 35), textcolor = color.white, size = f_label_size(labelSizeInput), tooltip = zoneValue.scoreText + (zoneValue.strategyMatches == "" ? "" : "\nMatched: " + zoneValue.strategyMatches))
            else
                label.set_x(zoneValue.zoneLabel, zoneValue.expiryTime)
                label.set_y(zoneValue.zoneLabel, zoneValue.midpoint)
                label.set_text(zoneValue.zoneLabel, zoneTagText)
                label.set_tooltip(zoneValue.zoneLabel, zoneValue.scoreText + (zoneValue.strategyMatches == "" ? "" : "\nMatched: " + zoneValue.strategyMatches))
            if showZoneMidpoint
                if na(zoneValue.midpointLine)
                    zoneValue.midpointLine := line.new(x1 = zoneValue.originTime, y1 = zoneValue.midpoint, x2 = zoneValue.expiryTime, y2 = zoneValue.midpoint, xloc = xloc.bar_time, color = color.new(directionColor, 45), style = line.style_dotted, width = 1)
            if showSourceAnnotation and not na(zoneValue.linkedLiquidityPrice)
                int sourceEndTime = zoneValue.qualifiedTime + sourceLineMinutes * 60 * 1000
                if na(zoneValue.sourceLine)
                    zoneValue.sourceLine := line.new(x1 = zoneValue.qualifiedTime, y1 = zoneValue.linkedLiquidityPrice, x2 = sourceEndTime, y2 = zoneValue.linkedLiquidityPrice, xloc = xloc.bar_time, color = color.new(neutralColor, 35), style = line.style_dotted, width = 1)
                if na(zoneValue.sourceLabel)
                    zoneValue.sourceLabel := label.new(x = zoneValue.qualifiedTime, y = zoneValue.linkedLiquidityPrice, text = zoneValue.linkedLiquiditySource, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = neutralColor, size = f_label_size(labelSizeInput))
        else if zoneValue.state < Z_TRIGGERED
            f_delete_zone_drawings(zoneValue)

// ─────────────────────────────────────────────────────────────────────────────
// Phase 7 — Entry, targets, stop, outcomes, and cleanup
// ─────────────────────────────────────────────────────────────────────────────
f_structure_stop(int directionValue) =>
    directionValue == DIR_BULL ? latestSwingLow : latestSwingHigh

f_create_trade(SetupZone zoneValue, float entryPriceValue, float stopPriceValue) =>
    bool createdValue = false
    float riskValue = math.abs(entryPriceValue - stopPriceValue)
    if f_stop_is_valid(zoneValue.direction, entryPriceValue, stopPriceValue, atr) and f_active_trade_count() < f_visible_trade_limit()
        float target1Value = entryPriceValue + zoneValue.direction * riskValue
        float target15Value = entryPriceValue + zoneValue.direction * riskValue * 1.5
        float target2Value = entryPriceValue + zoneValue.direction * riskValue * 2.0
        int plannedEndTimeValue = time + tradeDurationMinutes * 60 * 1000
        color directionColor = zoneValue.direction == DIR_BULL ? bullishSignalColor : bearishSignalColor
        string evidenceText = zoneValue.strategyName + " · " + zoneValue.zoneType + " · " + zoneValue.linkedLiquiditySource + " · " + zoneValue.structureType + " · Score " + str.tostring(zoneValue.score) + (zoneValue.strategyMatches == "" ? "" : " · Matches " + zoneValue.strategyMatches)

        float riskTop = math.max(entryPriceValue, stopPriceValue)
        float riskBottom = math.min(entryPriceValue, stopPriceValue)
        float reward1Top = math.max(entryPriceValue, target1Value)
        float reward1Bottom = math.min(entryPriceValue, target1Value)
        float reward15Top = math.max(target1Value, target15Value)
        float reward15Bottom = math.min(target1Value, target15Value)
        float reward2Top = math.max(target15Value, target2Value)
        float reward2Bottom = math.min(target15Value, target2Value)

        box riskBoxValue = box.new(left = time, top = riskTop, right = plannedEndTimeValue, bottom = riskBottom, xloc = xloc.bar_time, border_color = color.new(riskZoneColor, 100), bgcolor = color.new(riskZoneColor, riskZoneTransparency))
        box reward1BoxValue = box.new(left = time, top = reward1Top, right = plannedEndTimeValue, bottom = reward1Bottom, xloc = xloc.bar_time, border_color = color.new(rewardZoneColor, 100), bgcolor = color.new(rewardZoneColor, rewardTier1Transparency))
        box reward15BoxValue = box.new(left = time, top = reward15Top, right = plannedEndTimeValue, bottom = reward15Bottom, xloc = xloc.bar_time, border_color = color.new(rewardZoneColor, 100), bgcolor = color.new(rewardZoneColor, rewardTier15Transparency))
        box reward2BoxValue = box.new(left = time, top = reward2Top, right = plannedEndTimeValue, bottom = reward2Bottom, xloc = xloc.bar_time, border_color = color.new(rewardZoneColor, 100), bgcolor = color.new(rewardZoneColor, rewardTier2Transparency))

        label signal = label.new(x = time, y = entryPriceValue, text = f_direction_text(zoneValue.direction) + (showZoneScore ? " • " + str.tostring(zoneValue.score) : ""), xloc = xloc.bar_time, style = zoneValue.direction == DIR_BULL ? label.style_label_up : label.style_label_down, color = directionColor, textcolor = color.white, size = f_label_size(labelSizeInput), tooltip = evidenceText + (zoneValue.strategyMatches == "" ? "" : "\nMatched: " + zoneValue.strategyMatches))
        line stopLineValue = line.new(x1 = time, y1 = stopPriceValue, x2 = plannedEndTimeValue, y2 = stopPriceValue, xloc = xloc.bar_time, color = stopLineColor, style = line.style_solid, width = stopLineWidth)
        line target1LineValue = line.new(x1 = time, y1 = target1Value, x2 = plannedEndTimeValue, y2 = target1Value, xloc = xloc.bar_time, color = targetLineColor, style = line.style_solid, width = targetLineWidth)
        line target15LineValue = line.new(x1 = time, y1 = target15Value, x2 = plannedEndTimeValue, y2 = target15Value, xloc = xloc.bar_time, color = color.new(targetLineColor, 12), style = line.style_solid, width = targetLineWidth)
        line target2LineValue = line.new(x1 = time, y1 = target2Value, x2 = plannedEndTimeValue, y2 = target2Value, xloc = xloc.bar_time, color = color.new(targetLineColor, 22), style = line.style_solid, width = targetLineWidth)

        string stopText = "STOP" + (showTargetValues ? " " + str.tostring(stopPriceValue, format.mintick) : "")
        label stopLabelValue = label.new(x = plannedEndTimeValue, y = stopPriceValue, text = stopText, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = stopLineColor, size = f_label_size(labelSizeInput))
        label target1LabelValue = label.new(x = plannedEndTimeValue, y = target1Value, text = "1R" + (showTargetValues ? " " + str.tostring(target1Value, format.mintick) : ""), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = targetLineColor, size = f_label_size(labelSizeInput))
        label target15LabelValue = label.new(x = plannedEndTimeValue, y = target15Value, text = "1.5R" + (showTargetValues ? " " + str.tostring(target15Value, format.mintick) : ""), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = color.new(targetLineColor, 12), size = f_label_size(labelSizeInput))
        label target2LabelValue = label.new(x = plannedEndTimeValue, y = target2Value, text = "2R" + (showTargetValues ? " " + str.tostring(target2Value, format.mintick) : ""), xloc = xloc.bar_time, style = label.style_label_left, color = color.new(color.black, 100), textcolor = color.new(targetLineColor, 22), size = f_label_size(labelSizeInput))

        TradeHypothesis newTrade = TradeHypothesis.new(
             id = f_new_id("TRADE", time, bar_index),
             zoneId = zoneValue.id,
             zoneType = zoneValue.zoneType,
             strategyName = zoneValue.strategyName,
             strategyMatches = zoneValue.strategyMatches,
             direction = zoneValue.direction,
             state = T_ACTIVE,
             entryTime = time,
             entryBar = bar_index,
             plannedEndTime = plannedEndTimeValue,
             terminalTime = na,
             entryPrice = entryPriceValue,
             stopPrice = stopPriceValue,
             target1 = target1Value,
             target15 = target15Value,
             target2 = target2Value,
             target1Hit = false,
             target15Hit = false,
             target2Hit = false,
             terminalBar = na,
             score = zoneValue.score,
             evidence = evidenceText,
             zoneBox = na,
             riskBox = riskBoxValue,
             reward1Box = reward1BoxValue,
             reward15Box = reward15BoxValue,
             reward2Box = reward2BoxValue,
             signalLabel = signal,
             entryLine = na,
             stopLine = stopLineValue,
             target1Line = target1LineValue,
             target15Line = target15LineValue,
             target2Line = target2LineValue,
             entryLabel = na,
             stopLabel = stopLabelValue,
             target1Label = target1LabelValue,
             target15Label = target15LabelValue,
             target2Label = target2LabelValue,
             outcomeLabel = na)
        array.push(trades, newTrade)
        zoneValue.state := Z_TRIGGERED
        f_delete_zone_drawings(zoneValue)
        createdValue := true
        if enableAlerts and alertEntry
            f_send_json("entry_triggered", newTrade.id, newTrade.direction, newTrade.zoneType, newTrade.score, newTrade.entryPrice, newTrade.evidence)
    createdValue

// Update zone fill, expiry, entry pending, and entry triggers.
if barstate.isconfirmed and array.size(setupZones) > 0
    for i = array.size(setupZones) - 1 to 0
        SetupZone zoneValue = array.get(setupZones, i)
        if zoneValue.state == Z_ARMED or zoneValue.state == Z_ENTRY_PENDING
            bool touchedZone = low <= zoneValue.top and high >= zoneValue.bottom
            if touchedZone
                float fillValue = zoneValue.direction == DIR_BULL ? (zoneValue.top - low) / math.max(zoneValue.top - zoneValue.bottom, syminfo.mintick) : (high - zoneValue.bottom) / math.max(zoneValue.top - zoneValue.bottom, syminfo.mintick)
                zoneValue.fillPercent := math.max(zoneValue.fillPercent, f_clamp(fillValue, 0.0, 1.5))
                if zoneValue.state == Z_ARMED
                    zoneValue.touchCount += 1
                    zoneValue.state := Z_ENTRY_PENDING
                    zoneValue.entryPendingBar := bar_index
            bool farBoundaryClose = zoneValue.direction == DIR_BULL ? close < zoneValue.bottom : close > zoneValue.top
            bool timeExpired = time > zoneValue.expiryTime or (expireAtRthClose and endRth)
            bool oppositeMss = cancelOnOppositeMss and ((zoneValue.direction == DIR_BULL and bearStructureEvent and currentStructureType == "MSS") or (zoneValue.direction == DIR_BEAR and bullStructureEvent and currentStructureType == "MSS"))
            if farBoundaryClose
                zoneValue.state := Z_INVALIDATED
                f_delete_zone_drawings(zoneValue)
                expiryEvent := true
                expiredCount += 1
            else if timeExpired
                zoneValue.state := Z_EXPIRED
                f_delete_zone_drawings(zoneValue)
                expiryEvent := true
                expiredCount += 1
                if enableAlerts and alertExpiry
                    f_send_json("candidate_expired", zoneValue.id, zoneValue.direction, zoneValue.zoneType, zoneValue.score, zoneValue.midpoint, "Time or session expiry")
            else if oppositeMss
                zoneValue.state := Z_INVALIDATED
                f_delete_zone_drawings(zoneValue)
                expiryEvent := true
            else if zoneValue.state == Z_ENTRY_PENDING
                bool firstTouchAllowed = not firstTouchOnly or zoneValue.touchCount == 1
                bool confirmationAlive = bar_index - zoneValue.entryPendingBar <= entryConfirmationBars
                string resolvedEntryMode = entryMode == "Strategy defined" ? f_strategy_entry_mode(zoneValue.strategyName) : entryMode
                bool triggerValue = false
                if resolvedEntryMode == "First touch"
                    triggerValue := touchedZone
                else if resolvedEntryMode == "Consequent encroachment"
                    triggerValue := zoneValue.direction == DIR_BULL ? low <= zoneValue.midpoint and close > zoneValue.midpoint : high >= zoneValue.midpoint and close < zoneValue.midpoint
                else
                    triggerValue := zoneValue.direction == DIR_BULL ? touchedZone and close > zoneValue.top : touchedZone and close < zoneValue.bottom
                if firstTouchAllowed and confirmationAlive and triggerValue
                    float boundaryStop = zoneValue.direction == DIR_BULL ? zoneValue.bottom - stopBufferTicks * syminfo.mintick : zoneValue.top + stopBufferTicks * syminfo.mintick
                    float sweepStop = not na(zoneValue.linkedSweepExtreme) ? zoneValue.direction == DIR_BULL ? zoneValue.linkedSweepExtreme - stopBufferTicks * syminfo.mintick : zoneValue.linkedSweepExtreme + stopBufferTicks * syminfo.mintick : boundaryStop
                    float structureStop = f_structure_stop(zoneValue.direction)
                    float selectedStop = stopMode == "Sweep extreme" ? sweepStop : stopMode == "Structure swing" and not na(structureStop) ? structureStop + (zoneValue.direction == DIR_BULL ? -1 : 1) * stopBufferTicks * syminfo.mintick : boundaryStop
                    zoneValue.invalidationPrice := selectedStop
                    bool tradeCreated = f_create_trade(zoneValue, close, selectedStop)
                    if tradeCreated
                        triggeredCount += 1
                        entryEvent := true
                    else
                        zoneValue.state := Z_REJECTED
                        zoneValue.rejectionReason := "Stop outside configured limits"
                        f_delete_zone_drawings(zoneValue)
                        expiryEvent := true
                        expiredCount += 1
                else if not confirmationAlive
                    zoneValue.state := Z_EXPIRED
                    f_delete_zone_drawings(zoneValue)
                    expiryEvent := true
                    expiredCount += 1

// Trade outcome engine. All setup qualification and entries use confirmed bars.
// Confirmed pivots are acted on only when they become available; signals are not
// backfilled onto the pivot origin bar. Confirmed HTF requests use [1] values.
// Conservative same-bar rule: stop is processed before any target.
if barstate.isconfirmed and array.size(trades) > 0
    for i = array.size(trades) - 1 to 0
        TradeHypothesis tradeValue = array.get(trades, i)
        if not f_state_terminal_trade(tradeValue.state) and bar_index > tradeValue.entryBar
            bool expiredBeforeBar = time >= tradeValue.plannedEndTime
            if expiredBeforeBar
                tradeValue.state := T_TIME_EXPIRED
                tradeValue.terminalBar := bar_index
                tradeValue.terminalTime := tradeValue.plannedEndTime
                f_set_trade_end(tradeValue, tradeValue.plannedEndTime)
                f_fade_trade_drawings(tradeValue)
                string expiryText = tradeValue.target15Hit ? "TIME +1.5R" : tradeValue.target1Hit ? "TIME +1R" : "TIME"
                tradeValue.outcomeLabel := label.new(x = tradeValue.plannedEndTime, y = tradeValue.entryPrice, text = expiryText, xloc = xloc.bar_time, style = label.style_label_center, color = color.new(color.black, 100), textcolor = neutralColor, size = f_label_size(labelSizeInput))
                expiryEvent := true
                if enableAlerts and alertExpiry
                    f_send_json("trade_time_expired", tradeValue.id, tradeValue.direction, tradeValue.zoneType, tradeValue.score, tradeValue.entryPrice, tradeValue.evidence)
            else
                bool stopHitValue = tradeValue.direction == DIR_BULL ? low <= tradeValue.stopPrice : high >= tradeValue.stopPrice
                bool target1HitValue = tradeValue.direction == DIR_BULL ? high >= tradeValue.target1 : low <= tradeValue.target1
                bool target15HitValue = tradeValue.direction == DIR_BULL ? high >= tradeValue.target15 : low <= tradeValue.target15
                bool target2HitValue = tradeValue.direction == DIR_BULL ? high >= tradeValue.target2 : low <= tradeValue.target2
                if stopHitValue
                    tradeValue.state := tradeValue.target1Hit ? T_STOPPED_PARTIAL : T_STOPPED
                    tradeValue.terminalBar := bar_index
                    tradeValue.terminalTime := time
                    stoppedCount += 1
                    stopEvent := true
                    f_set_trade_end(tradeValue, time)
                    f_fade_trade_drawings(tradeValue)
                    tradeValue.outcomeLabel := label.new(x = time, y = tradeValue.stopPrice, text = "×" + (tradeValue.target1Hit ? " PARTIAL" : " −1R"), xloc = xloc.bar_time, style = label.style_label_center, color = color.new(color.black, 100), textcolor = stopLineColor, size = f_label_size(labelSizeInput))
                    if enableAlerts and alertStop
                        f_send_json("stop_reached", tradeValue.id, tradeValue.direction, tradeValue.zoneType, tradeValue.score, tradeValue.stopPrice, tradeValue.evidence)
                else
                    if target1HitValue and not tradeValue.target1Hit
                        tradeValue.target1Hit := true
                        tradeValue.state := T_TARGET_1
                        targetEvent := true
                        if not na(tradeValue.target1Label)
                            label.set_text(tradeValue.target1Label, "✓ 1R")
                            label.set_textcolor(tradeValue.target1Label, targetLineColor)
                        if enableAlerts and alertTargets
                            f_send_json("target_reached", tradeValue.id + "-1R", tradeValue.direction, tradeValue.zoneType, tradeValue.score, tradeValue.target1, "1R")
                    if target15HitValue and not tradeValue.target15Hit
                        tradeValue.target15Hit := true
                        tradeValue.state := T_TARGET_1_5
                        targetEvent := true
                        if not na(tradeValue.target15Label)
                            label.set_text(tradeValue.target15Label, "✓ 1.5R")
                            label.set_textcolor(tradeValue.target15Label, targetLineColor)
                        if enableAlerts and alertTargets
                            f_send_json("target_reached", tradeValue.id + "-1.5R", tradeValue.direction, tradeValue.zoneType, tradeValue.score, tradeValue.target15, "1.5R")
                    if target2HitValue and not tradeValue.target2Hit
                        tradeValue.target2Hit := true
                        tradeValue.state := T_COMPLETED
                        tradeValue.terminalBar := bar_index
                        tradeValue.terminalTime := time
                        completedCount += 1
                        targetEvent := true
                        if not na(tradeValue.target2Label)
                            label.set_text(tradeValue.target2Label, "✓ 2R")
                            label.set_textcolor(tradeValue.target2Label, targetLineColor)
                        f_set_trade_end(tradeValue, time)
                        f_fade_trade_drawings(tradeValue)
                        tradeValue.outcomeLabel := label.new(x = time, y = tradeValue.target2, text = "+2R", xloc = xloc.bar_time, style = label.style_label_center, color = color.new(color.black, 100), textcolor = targetLineColor, size = f_label_size(labelSizeInput))
                        if enableAlerts and alertTargets
                            f_send_json("trade_completed", tradeValue.id, tradeValue.direction, tradeValue.zoneType, tradeValue.score, tradeValue.target2, tradeValue.evidence)
                    else if time_close >= tradeValue.plannedEndTime and not f_state_terminal_trade(tradeValue.state)
                        tradeValue.state := T_TIME_EXPIRED
                        tradeValue.terminalBar := bar_index
                        tradeValue.terminalTime := tradeValue.plannedEndTime
                        f_set_trade_end(tradeValue, tradeValue.plannedEndTime)
                        f_fade_trade_drawings(tradeValue)
                        string expiryText = tradeValue.target15Hit ? "TIME +1.5R" : tradeValue.target1Hit ? "TIME +1R" : "TIME"
                        tradeValue.outcomeLabel := label.new(x = tradeValue.plannedEndTime, y = tradeValue.entryPrice, text = expiryText, xloc = xloc.bar_time, style = label.style_label_center, color = color.new(color.black, 100), textcolor = neutralColor, size = f_label_size(labelSizeInput))
                        expiryEvent := true
                        if enableAlerts and alertExpiry
                            f_send_json("trade_time_expired", tradeValue.id, tradeValue.direction, tradeValue.zoneType, tradeValue.score, tradeValue.entryPrice, tradeValue.evidence)

// Terminal trades fade immediately. They are deleted after five minutes by
// default, or retained for the configured historical window when requested.
if array.size(trades) > 0
    for i = array.size(trades) - 1 to 0
        TradeHypothesis tradeValue = array.get(trades, i)
        if f_state_terminal_trade(tradeValue.state) and not na(tradeValue.terminalTime)
            int retentionMilliseconds = (showPastTrades ? pastTradeRetentionHours * 60 : terminalRetentionMinutes) * 60 * 1000
            if time > tradeValue.terminalTime + retentionMilliseconds
                f_delete_trade_drawings(tradeValue)
                array.remove(trades, i)

while array.size(trades) > maximumRetainedTrades
    int removableIndex = -1
    for i = 0 to array.size(trades) - 1
        TradeHypothesis tradeValue = array.get(trades, i)
        if f_state_terminal_trade(tradeValue.state)
            removableIndex := i
            break
    if removableIndex >= 0
        TradeHypothesis oldTrade = array.get(trades, removableIndex)
        f_delete_trade_drawings(oldTrade)
        array.remove(trades, removableIndex)
    else
        break

// Remove terminal untriggered zones and bound zone storage.
if array.size(setupZones) > 0
    for i = array.size(setupZones) - 1 to 0
        SetupZone zoneValue = array.get(setupZones, i)
        bool canRemove = f_state_terminal_zone(zoneValue.state) or zoneValue.state == Z_TRIGGERED
        if canRemove and (time > zoneValue.expiryTime + 30 * 60 * 1000 or displayMode != "Research")
            f_delete_zone_drawings(zoneValue)
            array.remove(setupZones, i)
while array.size(setupZones) > MAX_ZONES
    SetupZone oldZone = array.shift(setupZones)
    f_delete_zone_drawings(oldZone)

// ─────────────────────────────────────────────────────────────────────────────
// Phase 8 — Static alert hooks and telemetry
// ─────────────────────────────────────────────────────────────────────────────
alertcondition(enableAlerts and alertCandidate and candidateEvent, "Meridian — Candidate armed", "Meridian Futures Setups: a qualified setup candidate was armed.")
alertcondition(enableAlerts and alertEntry and entryEvent, "Meridian — Entry triggered", "Meridian Futures Setups: a BUY or SELL hypothesis triggered.")
alertcondition(enableAlerts and alertTargets and targetEvent, "Meridian — Target reached", "Meridian Futures Setups: an R target was reached.")
alertcondition(enableAlerts and alertStop and stopEvent, "Meridian — Stop reached", "Meridian Futures Setups: an active trade hypothesis reached its invalidation.")
alertcondition(enableAlerts and alertExpiry and expiryEvent, "Meridian — Candidate ended", "Meridian Futures Setups: a candidate expired, invalidated, or was superseded.")

// ─────────────────────────────────────────────────────────────────────────────
// Phase 9 — Research diagnostics inside the overlay
// The full Strategy Tester companion remains a separate script.
// ─────────────────────────────────────────────────────────────────────────────
plot(showResearchDiagnostics or displayMode == "Research" ? latestQualifiedScore : na, "Latest qualified score", color = accentColor, display = display.data_window)
plot(showResearchDiagnostics or displayMode == "Research" ? sameTimeRvol : na, "Same-time RVOL", color = bullishSignalColor, display = display.data_window)
plot(showResearchDiagnostics or displayMode == "Research" ? realizedVolRatio : na, "Realized volatility ratio", color = bearishSignalColor, display = display.data_window)
plot(showResearchDiagnostics or displayMode == "Research" ? directionalEfficiency : na, "Directional efficiency", color = neutralColor, display = display.data_window)

var table statusTable = table.new(f_table_position(dashboardPosition), 2, 5, bgcolor = color.new(color.rgb(17, 20, 34), 8), frame_color = color.new(accentColor, 35), frame_width = 1, border_color = color.new(neutralColor, 80), border_width = 1)
if barstate.isfirst
    table.merge_cells(statusTable, 0, 0, 1, 0)
if barstate.islast
    bool showStatusValue = showOptionalDashboard or displayMode == "Research"
    color hiddenColor = color.new(color.black, 100)
    table.set_bgcolor(statusTable, showStatusValue ? color.new(color.rgb(17, 20, 34), 8) : hiddenColor)
    table.set_frame_color(statusTable, showStatusValue ? color.new(accentColor, 35) : hiddenColor)
    table.set_border_color(statusTable, showStatusValue ? color.new(neutralColor, 80) : hiddenColor)
    color statusText = showStatusValue ? color.rgb(230, 232, 240) : hiddenColor
    table.cell(statusTable, 0, 0, "MERIDIAN — SETUPS", bgcolor = showStatusValue ? color.new(accentColor, 18) : hiddenColor, text_color = statusText, text_size = size.small)
    table.cell(statusTable, 0, 1, "Engine", text_color = statusText, text_size = size.tiny)
    table.cell(statusTable, 1, 1, engineSupported ? "Ready" : "Unsupported", text_color = engineSupported ? bullishSignalColor : bearishSignalColor, text_size = size.tiny)
    table.cell(statusTable, 0, 2, "Armed / Active", text_color = statusText, text_size = size.tiny)
    int armedCount = 0
    if array.size(setupZones) > 0
        for i = 0 to array.size(setupZones) - 1
            SetupZone zoneValue = array.get(setupZones, i)
            armedCount += zoneValue.state == Z_ARMED or zoneValue.state == Z_ENTRY_PENDING ? 1 : 0
    table.cell(statusTable, 1, 2, str.tostring(armedCount) + " / " + str.tostring(f_active_trade_count()), text_color = statusText, text_size = size.tiny)
    table.cell(statusTable, 0, 3, "Strategy", text_color = statusText, text_size = size.tiny)
    table.cell(statusTable, 1, 3, strategyMode, text_color = statusText, text_size = size.tiny)
    table.cell(statusTable, 0, 4, "Latest", text_color = statusText, text_size = size.tiny)
    table.cell(statusTable, 1, 4, na(latestQualifiedScore) ? latestResearchReason : str.tostring(latestQualifiedScore) + " · " + latestResearchReason, text_color = color.new(statusText, 20), text_size = size.tiny)

// One unobtrusive message for unsupported charts.
var label unsupportedLabel = na
if barstate.islast
    if indicatorEnabled and not engineSupported
        if na(unsupportedLabel)
            unsupportedLabel := label.new(x = time, y = high, text = "Meridian Futures Setups\nUse NQ, MNQ, ES, or MES on 1m, 3m, 5m, or 15m", xloc = xloc.bar_time, style = label.style_label_down, color = color.new(color.rgb(17, 20, 34), 10), textcolor = color.rgb(230, 232, 240), size = size.small)
        else
            label.set_x(unsupportedLabel, time)
            label.set_y(unsupportedLabel, high)
    else if not na(unsupportedLabel)
        label.delete(unsupportedLabel)
        unsupportedLabel := na
