//@version=6
indicator(
     title = "Meridian Trading - Options Context",
     shorttitle = "Meridian Options Context",
     overlay = false,
     format = format.price,
     precision = 1
)

import TradingView/ta/12 as tvta

// ============================================================================
// MERIDIAN TRADING - OPTIONS CONTEXT
// Version 0.1.0
//
// Lower-pane context tool for intraday options trading on liquid underlyings
// such as SPY and QQQ.
//
// Core questions answered:
// 1. Is momentum bullish, bearish, or mixed?
// 2. Is participation elevated for this exact time of day?
// 3. Is price above or below daily RTH VWAP?
// 4. Is price above, inside, or below the opening range?
// 5. Do short-term EMAs confirm direction?
//
// This is a context dashboard, not a standalone trade signal.
// ============================================================================

// ─────────────────────────────────────────────────────────────────────────────
// INPUT GROUPS
// ─────────────────────────────────────────────────────────────────────────────
string GROUP_SESSION = "01. Session"
string GROUP_RSI     = "02. RSI"
string GROUP_RVOL    = "03. Relative Volume"
string GROUP_CONTEXT = "04. Context Engine"
string GROUP_VISUALS = "05. Visuals"
string GROUP_TABLE   = "06. Dashboard"
string GROUP_ALERTS  = "07. Alerts"
string GROUP_COLORS  = "08. Colours"

// ─────────────────────────────────────────────────────────────────────────────
// SESSION INPUTS
// Uses the same robust RTH-start logic as Meridian Options Levels.
// ─────────────────────────────────────────────────────────────────────────────
string sessionTimezone = input.string(
     "America/New_York",
     "Session timezone",
     group = GROUP_SESSION
)

string rthInput = input.session(
     "0930-1600",
     "Regular session",
     group = GROUP_SESSION
)

bool weekdaysOnly = input.bool(
     true,
     "Monday-Friday only",
     group = GROUP_SESSION
)

int openingRangeMinutes = input.int(
     15,
     "Opening-range minutes",
     minval = 1,
     maxval = 120,
     group = GROUP_SESSION
)

string sessionDays = weekdaysOnly ? ":23456" : ":1234567"
string rthSession = rthInput + sessionDays

bool inRth = not na(time(timeframe.period, rthSession, sessionTimezone))

int calendarDayKey =
     year(time, sessionTimezone) * 10000 +
     month(time, sessionTimezone) * 100 +
     dayofmonth(time, sessionTimezone)

bool newCalendarDay = na(calendarDayKey[1]) or calendarDayKey != calendarDayKey[1]

bool rthStart =
     inRth and (
         session.isfirstbar_regular or
         newCalendarDay or
         not inRth[1]
     )

if barstate.isfirst and not timeframe.isintraday
    runtime.error("Meridian Options Context is designed for intraday charts.")

// ─────────────────────────────────────────────────────────────────────────────
// RSI INPUTS
// ─────────────────────────────────────────────────────────────────────────────
bool showRsi = input.bool(true, "Show RSI", group = GROUP_RSI)
float rsiSource = input.source(close, "RSI source", group = GROUP_RSI)
int rsiLength = input.int(14, "RSI length", minval = 2, group = GROUP_RSI)

float rsiBullThreshold = input.float(
     55.0,
     "Bullish momentum threshold",
     minval = 50.0,
     maxval = 100.0,
     step = 0.5,
     group = GROUP_RSI
)

float rsiBearThreshold = input.float(
     45.0,
     "Bearish momentum threshold",
     minval = 0.0,
     maxval = 50.0,
     step = 0.5,
     group = GROUP_RSI
)

bool showTraditionalRsiLevels = input.bool(
     false,
     "Show 70 / 30 levels",
     group = GROUP_RSI
)

// ─────────────────────────────────────────────────────────────────────────────
// RELATIVE VOLUME INPUTS
// Uses TradingView's official ta library and compares each bar with equivalent
// time offsets from prior daily anchors.
// ─────────────────────────────────────────────────────────────────────────────
bool showRvol = input.bool(true, "Show normalized RVOL columns", group = GROUP_RVOL)

int rvolLookbackDays = input.int(
     20,
     "RVOL historical days",
     minval = 2,
     maxval = 100,
     group = GROUP_RVOL
)

bool adjustRealtimeRvol = input.bool(
     true,
     "Estimate unclosed real-time bar",
     group = GROUP_RVOL
)

float normalRvolThreshold = input.float(
     1.0,
     "Normal participation",
     minval = 0.1,
     step = 0.1,
     group = GROUP_RVOL
)

float highRvolThreshold = input.float(
     1.5,
     "High participation",
     minval = 0.1,
     step = 0.1,
     group = GROUP_RVOL
)

float extremeRvolThreshold = input.float(
     2.0,
     "Extreme participation",
     minval = 0.1,
     step = 0.1,
     group = GROUP_RVOL
)

float rvolDisplayCap = input.float(
     3.0,
     "RVOL display cap",
     minval = 1.0,
     step = 0.25,
     group = GROUP_RVOL,
     tooltip = "RVOL columns are normalized to a 0-100 pane. The table always shows the uncapped ratio."
)

bool showRvolBaseline = input.bool(
     true,
     "Show 1.0x RVOL guide",
     group = GROUP_RVOL
)

// ─────────────────────────────────────────────────────────────────────────────
// CONTEXT ENGINE INPUTS
// ─────────────────────────────────────────────────────────────────────────────
float vwapSource = input.source(hlc3, "Daily VWAP source", group = GROUP_CONTEXT)

int fastEmaLength = input.int(
     9,
     "Fast EMA",
     minval = 1,
     group = GROUP_CONTEXT
)

int slowEmaLength = input.int(
     21,
     "Slow EMA",
     minval = 2,
     group = GROUP_CONTEXT
)

bool includeOpeningRangeInScore = input.bool(
     true,
     "Include opening range in score",
     group = GROUP_CONTEXT
)

bool includeParticipationInScore = input.bool(
     true,
     "Include directional RVOL in score",
     group = GROUP_CONTEXT
)

// ─────────────────────────────────────────────────────────────────────────────
// VISUAL INPUTS
// ─────────────────────────────────────────────────────────────────────────────
bool showRsiZone = input.bool(true, "Shade RSI 40-60 zone", group = GROUP_VISUALS)

bool showRegimeBackground = input.bool(
     true,
     "Subtle regime background",
     group = GROUP_VISUALS
)

int regimeBackgroundTransparency = input.int(
     96,
     "Regime background transparency",
     minval = 85,
     maxval = 100,
     group = GROUP_VISUALS
)

// ─────────────────────────────────────────────────────────────────────────────
// DASHBOARD INPUTS
// Fixed-position tables do not move when users zoom or scroll.
// ─────────────────────────────────────────────────────────────────────────────
bool showDashboard = input.bool(true, "Show dashboard", group = GROUP_TABLE)

string dashboardPositionInput = input.string(
     "Top Right",
     "Dashboard position",
     options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"],
     group = GROUP_TABLE
)

string dashboardSizeInput = input.string(
     "Tiny",
     "Dashboard text size",
     options = ["Tiny", "Small", "Normal"],
     group = GROUP_TABLE
)

bool showDashboardVolumeValues = input.bool(
     false,
     "Show raw volume values",
     group = GROUP_TABLE
)

// ─────────────────────────────────────────────────────────────────────────────
// ALERT INPUTS
// ─────────────────────────────────────────────────────────────────────────────
bool enableAlerts = input.bool(true, "Enable alert conditions", group = GROUP_ALERTS)

bool alertStrongRegime = input.bool(
     true,
     "Strong bullish / bearish regime",
     group = GROUP_ALERTS
)

bool alertHighRvol = input.bool(
     true,
     "High RVOL threshold cross",
     group = GROUP_ALERTS
)

bool alertVwapCross = input.bool(
     true,
     "VWAP reclaim / loss",
     group = GROUP_ALERTS
)

bool alertOpeningRangeWithVolume = input.bool(
     true,
     "Opening-range break with high RVOL",
     group = GROUP_ALERTS
)

// ─────────────────────────────────────────────────────────────────────────────
// COLOURS
// ─────────────────────────────────────────────────────────────────────────────
color neonPurple = input.color(#D946EF, "Neon purple", group = GROUP_COLORS)
color lightPurple = input.color(#C4B5FD, "RSI line", group = GROUP_COLORS)
color bullishColor = input.color(#22D3EE, "Bullish", group = GROUP_COLORS)
color bearishColor = input.color(#FB7185, "Bearish", group = GROUP_COLORS)
color strongBullColor = input.color(#39FF88, "Strong bullish", group = GROUP_COLORS)
color strongBearColor = input.color(#FF4D6D, "Strong bearish", group = GROUP_COLORS)
color neutralColor = input.color(#A1A1AA, "Neutral", group = GROUP_COLORS)
color panelColor = input.color(#111118, "Dashboard background", group = GROUP_COLORS)

// ─────────────────────────────────────────────────────────────────────────────
// HELPER FUNCTIONS
// ─────────────────────────────────────────────────────────────────────────────
f_dashboardPosition(string positionText) =>
    positionText == "Top Left" ? position.top_left :
     positionText == "Bottom Right" ? position.bottom_right :
     positionText == "Bottom Left" ? position.bottom_left :
     position.top_right

f_textSize(string sizeText) =>
    sizeText == "Normal" ? size.normal :
     sizeText == "Small" ? size.small :
     size.tiny

f_formatRatio(float value) =>
    na(value) ? "n/a" : str.tostring(value, "#.00") + "x"

f_scoreText(int value) =>
    value > 0 ? "+" + str.tostring(value) : str.tostring(value)

f_formatVolume(float value) =>
    na(value) ? "n/a" :
     value >= 1000000000 ? str.tostring(value / 1000000000, "#.00") + "B" :
     value >= 1000000 ? str.tostring(value / 1000000, "#.00") + "M" :
     value >= 1000 ? str.tostring(value / 1000, "#.0") + "K" :
     str.tostring(value, "#")

f_regimeText(int score) =>
    score >= 4 ? "Strong Bull" :
     score >= 2 ? "Bullish" :
     score <= -4 ? "Strong Bear" :
     score <= -2 ? "Bearish" :
     "Mixed"

f_regimeColor(int score) =>
    score >= 4 ? strongBullColor :
     score >= 2 ? bullishColor :
     score <= -4 ? strongBearColor :
     score <= -2 ? bearishColor :
     neutralColor

f_rsiState(float value) =>
    na(value) ? "n/a" :
     value >= rsiBullThreshold ? "Bull" :
     value <= rsiBearThreshold ? "Bear" :
     "Neutral"

f_rsiColor(float value) =>
    na(value) ? neutralColor :
     value >= rsiBullThreshold ? bullishColor :
     value <= rsiBearThreshold ? bearishColor :
     lightPurple

f_rvolState(float value) =>
    na(value) ? "n/a" :
     value >= extremeRvolThreshold ? "Extreme" :
     value >= highRvolThreshold ? "High" :
     value >= normalRvolThreshold ? "Normal" :
     "Low"

f_rvolColor(float value, bool bullishBar) =>
    na(value) ? color.new(neutralColor, 75) :
     value >= extremeRvolThreshold ? color.new(neonPurple, 10) :
     value >= highRvolThreshold ? color.new(bullishBar ? bullishColor : bearishColor, 15) :
     value >= normalRvolThreshold ? color.new(bullishBar ? bullishColor : bearishColor, 48) :
     color.new(neutralColor, 78)

f_tableCell(
     table tableId,
     int column,
     int row,
     string cellText,
     color textColor,
     color backgroundColor,
     string horizontalAlignment
) =>
    table.cell(
         tableId,
         column,
         row,
         cellText,
         text_color = textColor,
         bgcolor = backgroundColor,
         text_size = f_textSize(dashboardSizeInput),
         text_halign = horizontalAlignment == "Left" ? text.align_left : text.align_right
    )

// ─────────────────────────────────────────────────────────────────────────────
// DAILY RTH VWAP
// Uses the same native daily anchor as Meridian Options Levels.
// ─────────────────────────────────────────────────────────────────────────────
bool dailyVwapAnchor = rthStart
float sessionVwap = ta.vwap(vwapSource, dailyVwapAnchor)

// ─────────────────────────────────────────────────────────────────────────────
// OPENING RANGE STATE
// ─────────────────────────────────────────────────────────────────────────────
var int openingRangeEndTime = na
var float openingRangeHigh = na
var float openingRangeLow = na
var bool openingRangeFinalized = false

if rthStart
    openingRangeEndTime := time + openingRangeMinutes * 60 * 1000
    openingRangeHigh := high
    openingRangeLow := low
    openingRangeFinalized := false

bool inOpeningRange =
     inRth and
     not na(openingRangeEndTime) and
     time < openingRangeEndTime

if inOpeningRange and not rthStart
    openingRangeHigh := math.max(openingRangeHigh, high)
    openingRangeLow := math.min(openingRangeLow, low)

if inRth and not inOpeningRange and not openingRangeFinalized and not na(openingRangeEndTime)
    openingRangeFinalized := true

bool openingRangeTimeframeWarning =
     timeframe.in_seconds() > openingRangeMinutes * 60

// ─────────────────────────────────────────────────────────────────────────────
// MOMENTUM AND TREND
// ─────────────────────────────────────────────────────────────────────────────
float rsiValue = ta.rsi(rsiSource, rsiLength)
float fastEma = ta.ema(close, fastEmaLength)
float slowEma = ta.ema(close, slowEmaLength)

// ─────────────────────────────────────────────────────────────────────────────
// REGULAR-SESSION RELATIVE VOLUME AT TIME
//
// The official TradingView ta library compares the current bar and cumulative
// volume with equivalent offsets from previous daily periods. Running the
// calculation inside a regular-session ticker prevents extended-hours volume
// from contaminating RTH comparisons.
// ─────────────────────────────────────────────────────────────────────────────
string regularSessionTicker = ticker.new(
     syminfo.prefix,
     syminfo.ticker,
     session.regular
)

[barVolumeRaw, barAverageRaw, barRvolRaw] = request.security(
     regularSessionTicker,
     timeframe.period,
     tvta.relativeVolume(
         rvolLookbackDays,
         "D",
         false,
         adjustRealtimeRvol
     ),
     gaps = barmerge.gaps_on,
     lookahead = barmerge.lookahead_off
)

[cumulativeVolumeRaw, cumulativeAverageRaw, cumulativeRvolRaw] = request.security(
     regularSessionTicker,
     timeframe.period,
     tvta.relativeVolume(
         rvolLookbackDays,
         "D",
         true,
         adjustRealtimeRvol
     ),
     gaps = barmerge.gaps_on,
     lookahead = barmerge.lookahead_off
)

float barRvol = inRth ? barRvolRaw : na
float cumulativeRvol = inRth ? cumulativeRvolRaw : na
float barVolume = inRth ? barVolumeRaw : na
float cumulativeVolume = inRth ? cumulativeVolumeRaw : na

// ─────────────────────────────────────────────────────────────────────────────
// CONTEXT COMPONENTS
// Score range is -5 to +5.
// ─────────────────────────────────────────────────────────────────────────────
int vwapScore =
     not inRth or na(sessionVwap) ? 0 :
     close > sessionVwap ? 1 :
     close < sessionVwap ? -1 :
     0

int rsiScore =
     na(rsiValue) ? 0 :
     rsiValue >= rsiBullThreshold ? 1 :
     rsiValue <= rsiBearThreshold ? -1 :
     0

int emaScore =
     fastEma > slowEma ? 1 :
     fastEma < slowEma ? -1 :
     0

int openingRangeScore =
     not includeOpeningRangeInScore or not openingRangeFinalized ? 0 :
     close > openingRangeHigh ? 1 :
     close < openingRangeLow ? -1 :
     0

bool bullishBar = close > open
bool bearishBar = close < open

int participationScore =
     not includeParticipationInScore or na(barRvol) or barRvol < highRvolThreshold ? 0 :
     bullishBar ? 1 :
     bearishBar ? -1 :
     0

int contextScore =
     vwapScore +
     rsiScore +
     emaScore +
     openingRangeScore +
     participationScore

string regimeText = f_regimeText(contextScore)
color regimeColor = f_regimeColor(contextScore)

// ─────────────────────────────────────────────────────────────────────────────
// STATE TEXT
// ─────────────────────────────────────────────────────────────────────────────
string vwapState =
     not inRth or na(sessionVwap) ? "n/a" :
     close > sessionVwap ? "Above" :
     close < sessionVwap ? "Below" :
     "At"

string openingRangeState =
     not inRth ? "Outside RTH" :
     openingRangeTimeframeWarning ? "Use lower TF" :
     not openingRangeFinalized ? "Forming" :
     close > openingRangeHigh ? "Above" :
     close < openingRangeLow ? "Below" :
     "Inside"

string emaState =
     fastEma > slowEma ? str.tostring(fastEmaLength) + " > " + str.tostring(slowEmaLength) :
     fastEma < slowEma ? str.tostring(fastEmaLength) + " < " + str.tostring(slowEmaLength) :
     "Flat"

string participationState =
     f_rvolState(barRvol) +
     (bullishBar ? " / Bull" : bearishBar ? " / Bear" : " / Flat")

// ─────────────────────────────────────────────────────────────────────────────
// PANE VISUALS
//
// RSI stays on its natural 0-100 scale.
// RVOL is normalized to the same 0-100 pane solely for visual comparison.
// The dashboard displays the uncapped RVOL values.
// ─────────────────────────────────────────────────────────────────────────────
float scaledRvol =
     na(barRvol) ? na :
     math.min(barRvol / rvolDisplayCap, 1.0) * 100.0

float scaledRvolBaseline =
     math.min(normalRvolThreshold / rvolDisplayCap, 1.0) * 100.0

color rvolColumnColor = f_rvolColor(barRvol, bullishBar)

plot(
     showRvol ? scaledRvol : na,
     title = "RVOL normalized",
     color = rvolColumnColor,
     style = plot.style_columns,
     linewidth = 1,
     histbase = 0
)

plot(
     showRvol and showRvolBaseline ? scaledRvolBaseline : na,
     title = "RVOL 1.0x guide",
     color = color.new(neutralColor, 78),
     linewidth = 1,
     style = plot.style_line
)

color rsiLineColor = color.from_gradient(
     rsiValue,
     rsiBearThreshold,
     rsiBullThreshold,
     bearishColor,
     bullishColor
)

plot(
     showRsi ? rsiValue : na,
     title = "RSI",
     color = rsiLineColor,
     linewidth = 2
)

rsiUpperGuide = hline(
     60,
     "RSI 60",
     color = showRsi ? color.new(bullishColor, 60) : na,
     linestyle = hline.style_dotted
)

rsiCenterGuide = hline(
     50,
     "RSI 50",
     color = showRsi ? color.new(neutralColor, 62) : na,
     linestyle = hline.style_dashed
)

rsiLowerGuide = hline(
     40,
     "RSI 40",
     color = showRsi ? color.new(bearishColor, 60) : na,
     linestyle = hline.style_dotted
)

fill(
     rsiUpperGuide,
     rsiLowerGuide,
     color = showRsi and showRsiZone ? color.new(neonPurple, 95) : na,
     title = "RSI neutral zone"
)

hline(
     70,
     "RSI 70",
     color = showRsi and showTraditionalRsiLevels ? color.new(bearishColor, 72) : na,
     linestyle = hline.style_dotted
)

hline(
     30,
     "RSI 30",
     color = showRsi and showTraditionalRsiLevels ? color.new(bullishColor, 72) : na,
     linestyle = hline.style_dotted
)

hline(100, "Pane maximum", color = color.new(color.white, 100))
hline(0, "Pane minimum", color = color.new(color.white, 100))

bgcolor(
     showRegimeBackground and inRth ?
         color.new(regimeColor, regimeBackgroundTransparency) :
         na,
     title = "Context regime background"
)

// Hidden plots keep values available in Data Window and alert placeholders.
plot(contextScore, "Context Score", display = display.none)
plot(barRvol, "Bar RVOL", display = display.none)
plot(cumulativeRvol, "Cumulative RVOL", display = display.none)
plot(sessionVwap, "Daily RTH VWAP", display = display.none)

// ─────────────────────────────────────────────────────────────────────────────
// FIXED DASHBOARD
// Tables remain fixed while users zoom or scroll.
// ─────────────────────────────────────────────────────────────────────────────
var table contextTable = table.new(
     f_dashboardPosition(dashboardPositionInput),
     2,
     9,
     bgcolor = panelColor,
     frame_color = color.new(neonPurple, 35),
     frame_width = 1,
     border_color = color.new(neutralColor, 88),
     border_width = 1
)

if barstate.islast
    if showDashboard
        color headerBackground = color.new(neonPurple, 12)
        color rowBackground = color.new(panelColor, 3)
        color alternateBackground = color.new(#18121F, 4)

        f_tableCell(contextTable, 0, 0, "MERIDIAN CONTEXT", color.black, headerBackground, "Left")
        f_tableCell(contextTable, 1, 0, f_scoreText(contextScore), color.black, headerBackground, "Right")

        f_tableCell(contextTable, 0, 1, "Regime", neutralColor, rowBackground, "Left")
        f_tableCell(contextTable, 1, 1, regimeText, regimeColor, rowBackground, "Right")

        f_tableCell(contextTable, 0, 2, "RSI", neutralColor, alternateBackground, "Left")
        f_tableCell(
             contextTable,
             1,
             2,
             str.tostring(rsiValue, "#.0") + " / " + f_rsiState(rsiValue),
             f_rsiColor(rsiValue),
             alternateBackground,
             "Right"
        )

        f_tableCell(contextTable, 0, 3, "Bar RVOL", neutralColor, rowBackground, "Left")
        f_tableCell(
             contextTable,
             1,
             3,
             f_formatRatio(barRvol) +
                 (showDashboardVolumeValues ? "  " + f_formatVolume(barVolume) : ""),
             f_rvolColor(barRvol, bullishBar),
             rowBackground,
             "Right"
        )

        f_tableCell(contextTable, 0, 4, "Cum RVOL", neutralColor, alternateBackground, "Left")
        f_tableCell(
             contextTable,
             1,
             4,
             f_formatRatio(cumulativeRvol) +
                 (showDashboardVolumeValues ? "  " + f_formatVolume(cumulativeVolume) : ""),
             cumulativeRvol >= highRvolThreshold ? neonPurple : neutralColor,
             alternateBackground,
             "Right"
        )

        f_tableCell(contextTable, 0, 5, "VWAP", neutralColor, rowBackground, "Left")
        f_tableCell(
             contextTable,
             1,
             5,
             vwapState,
             vwapScore > 0 ? bullishColor : vwapScore < 0 ? bearishColor : neutralColor,
             rowBackground,
             "Right"
        )

        f_tableCell(contextTable, 0, 6, "Opening Range", neutralColor, alternateBackground, "Left")
        f_tableCell(
             contextTable,
             1,
             6,
             openingRangeState,
             openingRangeScore > 0 ? bullishColor : openingRangeScore < 0 ? bearishColor : neutralColor,
             alternateBackground,
             "Right"
        )

        f_tableCell(contextTable, 0, 7, "EMA Trend", neutralColor, rowBackground, "Left")
        f_tableCell(
             contextTable,
             1,
             7,
             emaState,
             emaScore > 0 ? bullishColor : emaScore < 0 ? bearishColor : neutralColor,
             rowBackground,
             "Right"
        )

        f_tableCell(contextTable, 0, 8, "Participation", neutralColor, alternateBackground, "Left")
        f_tableCell(
             contextTable,
             1,
             8,
             participationState,
             participationScore > 0 ? bullishColor :
                 participationScore < 0 ? bearishColor :
                 neutralColor,
             alternateBackground,
             "Right"
        )
    else
        table.clear(contextTable, 0, 0, 1, 8)

// ─────────────────────────────────────────────────────────────────────────────
// ALERT CONDITIONS
// Close-confirmed to reduce intrabar noise. Cross functions are evaluated on
// every bar before applying user toggles, preserving consistent history.
// ─────────────────────────────────────────────────────────────────────────────
bool rawHighRvolCross = ta.crossover(barRvol, highRvolThreshold)
bool rawExtremeRvolCross = ta.crossover(barRvol, extremeRvolThreshold)
bool rawVwapReclaim = ta.crossover(close, sessionVwap)
bool rawVwapLoss = ta.crossunder(close, sessionVwap)
bool rawOpeningRangeBreakout = ta.crossover(close, openingRangeHigh)
bool rawOpeningRangeBreakdown = ta.crossunder(close, openingRangeLow)

bool confirmedBar = barstate.isconfirmed

bool enteredStrongBull =
     enableAlerts and
     alertStrongRegime and
     confirmedBar and
     contextScore >= 4 and
     contextScore[1] < 4

bool enteredStrongBear =
     enableAlerts and
     alertStrongRegime and
     confirmedBar and
     contextScore <= -4 and
     contextScore[1] > -4

bool highRvolCross =
     enableAlerts and
     alertHighRvol and
     confirmedBar and
     not na(barRvol) and
     rawHighRvolCross

bool extremeRvolCross =
     enableAlerts and
     alertHighRvol and
     confirmedBar and
     not na(barRvol) and
     rawExtremeRvolCross

bool vwapReclaim =
     enableAlerts and
     alertVwapCross and
     confirmedBar and
     inRth and
     rawVwapReclaim

bool vwapLoss =
     enableAlerts and
     alertVwapCross and
     confirmedBar and
     inRth and
     rawVwapLoss

bool openingRangeBreakoutWithVolume =
     enableAlerts and
     alertOpeningRangeWithVolume and
     confirmedBar and
     openingRangeFinalized and
     not na(barRvol) and
     barRvol >= highRvolThreshold and
     rawOpeningRangeBreakout

bool openingRangeBreakdownWithVolume =
     enableAlerts and
     alertOpeningRangeWithVolume and
     confirmedBar and
     openingRangeFinalized and
     not na(barRvol) and
     barRvol >= highRvolThreshold and
     rawOpeningRangeBreakdown

alertcondition(
     enteredStrongBull,
     "Strong Bullish Context",
     "{{ticker}} entered a strong bullish options context. Score: {{plot(\"Context Score\")}}."
)

alertcondition(
     enteredStrongBear,
     "Strong Bearish Context",
     "{{ticker}} entered a strong bearish options context. Score: {{plot(\"Context Score\")}}."
)

alertcondition(
     highRvolCross,
     "High RVOL",
     "{{ticker}} bar RVOL crossed the high threshold. RVOL: {{plot(\"Bar RVOL\")}}."
)

alertcondition(
     extremeRvolCross,
     "Extreme RVOL",
     "{{ticker}} bar RVOL crossed the extreme threshold. RVOL: {{plot(\"Bar RVOL\")}}."
)

alertcondition(
     vwapReclaim,
     "VWAP Reclaim",
     "{{ticker}} reclaimed daily RTH VWAP at {{close}}."
)

alertcondition(
     vwapLoss,
     "VWAP Loss",
     "{{ticker}} lost daily RTH VWAP at {{close}}."
)

alertcondition(
     openingRangeBreakoutWithVolume,
     "Opening-Range Breakout + RVOL",
     "{{ticker}} broke above the opening range with high relative volume at {{close}}."
)

alertcondition(
     openingRangeBreakdownWithVolume,
     "Opening-Range Breakdown + RVOL",
     "{{ticker}} broke below the opening range with high relative volume at {{close}}."
)
