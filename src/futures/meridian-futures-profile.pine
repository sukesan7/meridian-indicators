     tooltip = "Used only when Layout with Futures Levels is disabled.")
string dashboardTextSize = input.string("Small", "Dashboard text size", options = ["Tiny", "Small", "Normal", "Large"], group = G_DASH)
int dashboardColumnWidth = input.int(11, "Dashboard column width (%)", minval = 8, maxval = 20, group = G_DASH)
int dashboardHeaderHeight = input.int(4, "Header height (%)", minval = 2, maxval = 10, group = G_DASH)
int dashboardCardHeight = input.int(7, "Card row height (%)", minval = 4, maxval = 14, group = G_DASH)
int dashboardFooterHeight = input.int(2, "Footer height (%)", minval = 1, maxval = 6, group = G_DASH)

bool enableDynamicAlerts = input.bool(false, "Enable dynamic JSON alert() calls", group = G_ALERTS)
bool alertPreviousLevels = input.bool(true, "Alert on previous POC / VAH / VAL", group = G_ALERTS)
bool alertSinglePrints = input.bool(true, "Alert on previous single prints", group = G_ALERTS)
bool alertPoorHighLow = input.bool(true, "Alert on poor high / low repair", group = G_ALERTS)
bool alertAuctionChanges = input.bool(true, "Alert on auction-state changes", group = G_ALERTS)

f_line_style(string name) =>
    switch name
        "Solid"  => line.style_solid
        "Dotted" => line.style_dotted
        => line.style_dashed

f_table_position(string name) =>
    switch name
        "Top Left"     => position.top_left
        "Bottom Right" => position.bottom_right
        "Bottom Left"  => position.bottom_left
        "Middle Right" => position.middle_right
        "Middle Left"  => position.middle_left
        => position.top_right

f_dashboard_position(bool withFuturesLevels, string standalonePosition) =>
    withFuturesLevels ? position.top_right : f_table_position(standalonePosition)

f_text_size(string name) =>
    switch name
        "Tiny"   => size.tiny
        "Normal" => size.normal
        "Large"  => size.large
        => size.small

f_block_minutes(string name) =>
    switch name
        "5 Minutes"  => 5
        "10 Minutes" => 10
        "15 Minutes" => 15
        "60 Minutes" => 60
        => 30

f_default_row_ticks() =>
    bool nasdaqFuture = syminfo.root == "NQ" or syminfo.root == "MNQ"
    bool spFuture = syminfo.root == "ES" or syminfo.root == "MES"
    nasdaqFuture ? 8 : spFuture ? 4 : 4

f_choose_ticks(float previousRange) =>
    int fallbackTicks = math.max(f_default_row_ticks(), minimumAutomaticTicks)
    int autoTicks = not na(previousRange) and previousRange > syminfo.mintick ?
         int(math.ceil(previousRange / syminfo.mintick / automaticTargetRows)) : fallbackTicks
    rowSizeMode == "Manual" ? manualTicksPerRow : math.max(autoTicks, minimumAutomaticTicks)

f_row_low(int row, float rowSize) =>
    row * rowSize

f_row_high(int row, float rowSize) =>
    (row + 1) * rowSize

f_row_center(int row, float rowSize) =>
    (row + 0.5) * rowSize

f_int_get(map<int, int> sourceMap, int key) =>
    sourceMap.contains(key) ? sourceMap.get(key) : 0

f_float_get(map<int, float> sourceMap, int key) =>
    sourceMap.contains(key) ? sourceMap.get(key) : 0.0

f_tpo_count(map<int, int> sourceMap, int row, bool includeActive, int activeLowRow, int activeHighRow) =>
    f_int_get(sourceMap, row) + (includeActive and row >= activeLowRow and row <= activeHighRow ? 1 : 0)

f_add_tpo_block(
     map<int, int> countMap,
     int lowRow,
     int highRow,
     int existingMinRow,
     int existingMaxRow) =>
    int newMinRow = existingMinRow
    int newMaxRow = existingMaxRow
    bool overflow = false
    int rowsTouched = highRow - lowRow + 1
    if rowsTouched > 0 and rowsTouched <= maximumRowsPerBlock
        for row = lowRow to highRow
            countMap.put(row, f_int_get(countMap, row) + 1)
        newMinRow := na(existingMinRow) ? lowRow : math.min(existingMinRow, lowRow)
        newMaxRow := na(existingMaxRow) ? highRow : math.max(existingMaxRow, highRow)
    else if rowsTouched > maximumRowsPerBlock
        overflow := true
    [newMinRow, newMaxRow, overflow]

f_add_estimated_volume(
     map<int, float> volumeMap,
     int lowRow,
     int highRow,
     float barVolume) =>
    bool overflow = false
    int rowsTouched = highRow - lowRow + 1
    if rowsTouched > 0 and rowsTouched <= maximumRowsPerBlock
        float volumePerRow = nz(barVolume, 0.0) / rowsTouched
        for row = lowRow to highRow
            volumeMap.put(row, f_float_get(volumeMap, row) + volumePerRow)
    else if rowsTouched > maximumRowsPerBlock
        overflow := true
    overflow

f_tpo_stats(
     map<int, int> countMap,
     int minRow,
     int maxRow,
     float rowSize,
     bool includeActive,
     int activeLowRow,
     int activeHighRow,
     float vaPercent) =>
    bool valid = not na(minRow) and not na(maxRow) and maxRow >= minRow and rowSize > 0.0
    int pocRow = int(na)
    int vahRow = int(na)
    int valRow = int(na)
    int totalTpo = 0
    int tpoAbove = 0
    int tpoBelow = 0
    int singleRows = 0
    int maximumCount = 0
    bool poorHigh = false
    bool poorLow = false
    float weightedMeanRow = na
    float skewness = na

    if valid
        float midpointRow = (minRow + maxRow) * 0.5
        float weightedSum = 0.0
        for row = minRow to maxRow
            int rowCount = f_tpo_count(countMap, row, includeActive, activeLowRow, activeHighRow)
            totalTpo += rowCount
            weightedSum += row * rowCount
            bool betterPoc = rowCount > maximumCount
            bool equalAndCloser = rowCount == maximumCount and rowCount > 0 and (na(pocRow) or math.abs(row - midpointRow) < math.abs(pocRow - midpointRow))
            bool equalDistanceHigher = rowCount == maximumCount and rowCount > 0 and not na(pocRow) and math.abs(row - midpointRow) == math.abs(pocRow - midpointRow) and row > pocRow
            if betterPoc or equalAndCloser or equalDistanceHigher
                maximumCount := rowCount
                pocRow := row

        if totalTpo > 0 and not na(pocRow)
            weightedMeanRow := weightedSum / totalTpo
            float secondMoment = 0.0
            float thirdMoment = 0.0
            for row = minRow to maxRow
                int rowCount = f_tpo_count(countMap, row, includeActive, activeLowRow, activeHighRow)
                float centered = row - weightedMeanRow
                secondMoment += centered * centered * rowCount
                thirdMoment += centered * centered * centered * rowCount
                if row > pocRow
                    tpoAbove += rowCount
                else if row < pocRow
                    tpoBelow += rowCount
                if row > minRow and row < maxRow and rowCount == 1
                    singleRows += 1

            float varianceRows = secondMoment / totalTpo
            float standardDeviationRows = math.sqrt(math.max(varianceRows, 0.0))
            skewness := standardDeviationRows > 1e-9 ? (thirdMoment / totalTpo) / math.pow(standardDeviationRows, 3.0) : 0.0

            int targetTpo = int(math.ceil(totalTpo * vaPercent / 100.0))
            int includedTpo = f_tpo_count(countMap, pocRow, includeActive, activeLowRow, activeHighRow)
            int valueLowRow = pocRow
            int valueHighRow = pocRow
            int safetyCounter = 0
            while includedTpo < targetTpo and (valueLowRow > minRow or valueHighRow < maxRow) and safetyCounter <= maxRow - minRow + 2
                int aboveCount = valueHighRow < maxRow ? f_tpo_count(countMap, valueHighRow + 1, includeActive, activeLowRow, activeHighRow) : -1
                int belowCount = valueLowRow > minRow ? f_tpo_count(countMap, valueLowRow - 1, includeActive, activeLowRow, activeHighRow) : -1
                if aboveCount >= belowCount
                    valueHighRow += 1
                    includedTpo += math.max(aboveCount, 0)
                else
                    valueLowRow -= 1
                    includedTpo += math.max(belowCount, 0)
                safetyCounter += 1
            vahRow := valueHighRow
            valRow := valueLowRow
            poorHigh := f_tpo_count(countMap, maxRow, includeActive, activeLowRow, activeHighRow) > 1
            poorLow := f_tpo_count(countMap, minRow, includeActive, activeLowRow, activeHighRow) > 1

    float profileHigh = valid ? f_row_high(maxRow, rowSize) : na
    float profileLow = valid ? f_row_low(minRow, rowSize) : na
    float profileMid = valid ? (profileHigh + profileLow) * 0.5 : na
    float pocPrice = valid and not na(pocRow) ? f_row_center(pocRow, rowSize) : na
    float vahPrice = valid and not na(vahRow) ? f_row_high(vahRow, rowSize) : na
    float valPrice = valid and not na(valRow) ? f_row_low(valRow, rowSize) : na
    [valid, pocRow, vahRow, valRow, totalTpo, tpoAbove, tpoBelow, singleRows, maximumCount, poorHigh, poorLow, weightedMeanRow, skewness, profileHigh, profileLow, profileMid, pocPrice, vahPrice, valPrice]

f_volume_stats(
     map<int, float> volumeMap,
     int minRow,
     int maxRow,
     float rowSize,
     float vaPercent) =>
    bool valid = not na(minRow) and not na(maxRow) and maxRow >= minRow and rowSize > 0.0 and volumeMap.size() > 0
    int pocRow = int(na)
    int vahRow = int(na)
    int valRow = int(na)
    float totalVolume = 0.0
    float maximumVolume = 0.0
    if valid
        float midpointRow = (minRow + maxRow) * 0.5
        for row = minRow to maxRow
            float rowVolume = f_float_get(volumeMap, row)
            totalVolume += rowVolume
            bool betterPoc = rowVolume > maximumVolume
            bool equalAndCloser = rowVolume == maximumVolume and rowVolume > 0.0 and (na(pocRow) or math.abs(row - midpointRow) < math.abs(pocRow - midpointRow))
            if betterPoc or equalAndCloser
                maximumVolume := rowVolume
                pocRow := row
        if totalVolume > 0.0 and not na(pocRow)
            float targetVolume = totalVolume * vaPercent / 100.0
            float includedVolume = f_float_get(volumeMap, pocRow)
            int valueLowRow = pocRow
            int valueHighRow = pocRow
            int safetyCounter = 0
            while includedVolume < targetVolume and (valueLowRow > minRow or valueHighRow < maxRow) and safetyCounter <= maxRow - minRow + 2
                float aboveVolume = valueHighRow < maxRow ? f_float_get(volumeMap, valueHighRow + 1) : -1.0
                float belowVolume = valueLowRow > minRow ? f_float_get(volumeMap, valueLowRow - 1) : -1.0
                if aboveVolume >= belowVolume
                    valueHighRow += 1
                    includedVolume += math.max(aboveVolume, 0.0)
                else
                    valueLowRow -= 1
                    includedVolume += math.max(belowVolume, 0.0)
                safetyCounter += 1
            vahRow := valueHighRow
            valRow := valueLowRow
    float pocPrice = valid and not na(pocRow) ? f_row_center(pocRow, rowSize) : na
    float vahPrice = valid and not na(vahRow) ? f_row_high(vahRow, rowSize) : na
    float valPrice = valid and not na(valRow) ? f_row_low(valRow, rowSize) : na
    [valid, pocRow, vahRow, valRow, totalVolume, maximumVolume, pocPrice, vahPrice, valPrice]

f_profile_shape(
     map<int, int> countMap,
     int minRow,
     int maxRow,
     bool includeActive,
     int activeLowRow,
     int activeHighRow,
     int pocRow,
     float skewness,
     float profileRange,
     float initialBalanceRange) =>
    int shapeCode = 0
    string shapeText = "Developing"
    bool doubleDistribution = false
    if not na(minRow) and not na(maxRow) and not na(pocRow) and maxRow > minRow
        int primaryPeakRow = pocRow
        int primaryPeakCount = f_tpo_count(countMap, primaryPeakRow, includeActive, activeLowRow, activeHighRow)
        int secondaryPeakRow = int(na)
        int secondaryPeakCount = 0
        for row = minRow to maxRow
            int rowCount = f_tpo_count(countMap, row, includeActive, activeLowRow, activeHighRow)
            if math.abs(row - primaryPeakRow) >= doublePeakMinimumSeparation and rowCount > secondaryPeakCount
                secondaryPeakCount := rowCount
                secondaryPeakRow := row
        if not na(secondaryPeakRow) and secondaryPeakCount >= primaryPeakCount * doublePeakMinimumRatio
            int valleyStart = math.min(primaryPeakRow, secondaryPeakRow)
            int valleyEnd = math.max(primaryPeakRow, secondaryPeakRow)
            int valleyCount = 1000000
            if valleyEnd - valleyStart > 1
                for row = valleyStart + 1 to valleyEnd - 1
                    valleyCount := math.min(valleyCount, f_tpo_count(countMap, row, includeActive, activeLowRow, activeHighRow))
            doubleDistribution := valleyCount <= math.min(primaryPeakCount, secondaryPeakCount) * doublePeakValleyRatio

        float pocLocation = (pocRow - minRow) / math.max(maxRow - minRow, 1.0)
        bool trendProfile = not na(initialBalanceRange) and initialBalanceRange > 0.0 and profileRange / initialBalanceRange >= trendRangeExtension
        if doubleDistribution
            shapeCode := 4
            shapeText := "Double Distribution"
        else if trendProfile and (pocLocation >= 0.70 or pocLocation <= 0.30 or math.abs(nz(skewness)) >= shapeSkewThreshold)
            shapeCode := 5
            shapeText := "Trend Profile"
        else if nz(skewness) <= -shapeSkewThreshold and pocLocation > 0.52
            shapeCode := 2
            shapeText := "P-shaped"
        else if nz(skewness) >= shapeSkewThreshold and pocLocation < 0.48
            shapeCode := 3
            shapeText := "b-shaped"
        else if math.abs(nz(skewness)) < shapeSkewThreshold and pocLocation >= 0.35 and pocLocation <= 0.65
            shapeCode := 1
            shapeText := "D-shaped"
        else
            shapeCode := 0
            shapeText := "Neutral / Mixed"
    [shapeCode, shapeText, doubleDistribution]

f_trim_boxes(array<box> objects, int used) =>
    while objects.size() > used
        box.delete(objects.pop())

f_trim_labels(array<label> objects, int used) =>
    while objects.size() > used
        label.delete(objects.pop())

f_set_box(
     array<box> objects,
     int index,
     int left,
     float top,
     int right,
     float bottom,
     color borderColor,
     color fillColor) =>
    box object = index < objects.size() ? objects.get(index) : na
    if na(object)
        object := box.new(left, top, right, bottom, xloc = xloc.bar_index, border_color = borderColor, border_width = 1, bgcolor = fillColor)
        if index < objects.size()
            objects.set(index, object)
        else
            objects.push(object)
    else
        box.set_left(object, left)
        box.set_top(object, top)
        box.set_right(object, right)
        box.set_bottom(object, bottom)
        box.set_border_color(object, borderColor)
        box.set_bgcolor(object, fillColor)

f_set_label(
     array<label> objects,
     int index,
     int x,
     float y,
     string labelText,
     color background,
     color foreground,
     string styleName,
     string sizeName) =>
    label object = index < objects.size() ? objects.get(index) : na
    string styleValue = styleName == "Left" ? label.style_label_left : styleName == "Right" ? label.style_label_right : label.style_none
    if na(object)
        object := label.new(x, y, labelText, xloc = xloc.bar_index, style = styleValue, color = background, textcolor = foreground, size = f_text_size(sizeName))
        if index < objects.size()
            objects.set(index, object)
        else
            objects.push(object)
    else
        label.set_xy(object, x, y)
        label.set_text(object, labelText)
        label.set_style(object, styleValue)
        label.set_color(object, background)
        label.set_textcolor(object, foreground)
        label.set_size(object, f_text_size(sizeName))

int blockMinutes = f_block_minutes(blockSizeInput)
int blockMilliseconds = blockMinutes * 60 * 1000
float chartSeconds = timeframe.in_seconds()
int chartMinutes = timeframe.isintraday ? int(math.round(chartSeconds / 60.0)) : 0
bool supportedTimeframe = timeframe.isintraday and chartMinutes >= 1 and chartMinutes <= maximumChartMinutes and chartMinutes <= blockMinutes
bool standardChart = chart.is_standard
bool chartWarning = not supportedTimeframe or (requireStandardCandles and not standardChart)

bool inRTH = not na(time(timeframe.period, rthSession, sessionTimezone))
int localYear = year(time, sessionTimezone)
int localMonth = month(time, sessionTimezone)
int localDay = dayofmonth(time, sessionTimezone)
int dateKey = localYear * 10000 + localMonth * 100 + localDay
bool newRTH = inRTH and (bar_index == 0 or not inRTH[1] or dateKey != dateKey[1])
bool endRTH = not inRTH and inRTH[1]
int rthStartTimestamp = timestamp(sessionTimezone, localYear, localMonth, localDay, rthOpenHour, rthOpenMinute)
int currentBlockId = inRTH ? int(math.floor((time - rthStartTimestamp) / blockMilliseconds)) : -1

var map<int, int> currentTpo = map.new<int, int>()
var map<int, int> previousTpo = map.new<int, int>()
var map<int, float> currentEstimatedVolume = map.new<int, float>()
var map<int, float> previousEstimatedVolume = map.new<int, float>()

var float currentRowSize = na
var float previousRowSize = na
var int currentMinRow = int(na)
var int currentMaxRow = int(na)
var int previousMinRow = int(na)
var int previousMaxRow = int(na)
var bool currentHasData = false
var bool previousHasData = false
var bool currentComplete = false
var bool currentOverflow = false
var bool previousOverflow = false

var int currentSessionStartBar = int(na)
var int currentSessionEndBar = int(na)
var int previousSessionStartBar = int(na)
var int previousSessionEndBar = int(na)
var float currentOpen = na
var float currentClose = na
var float previousOpen = na
var float previousClose = na
var float currentHigh = na
var float currentLow = na
var float previousHigh = na
var float previousLow = na
var float currentIbHigh = na
var float currentIbLow = na
var float previousIbHigh = na
var float previousIbLow = na
var float currentRotationFactor = 0.0
var float previousRotationFactor = 0.0
var int currentCommittedBlocks = 0
var int previousCommittedBlocks = 0

var int activeBlockId = -1
var float activeBlockHigh = na
var float activeBlockLow = na
var float lastCommittedBlockHigh = na
var float lastCommittedBlockLow = na

if newRTH
    if currentHasData
        if activeBlockId >= 0 and not na(activeBlockHigh) and not na(activeBlockLow) and not na(currentRowSize)
            int finalLowRow = int(math.floor(activeBlockLow / currentRowSize))
            int finalHighRow = int(math.floor(activeBlockHigh / currentRowSize))
            [newMinRow, newMaxRow, blockOverflow] = f_add_tpo_block(currentTpo, finalLowRow, finalHighRow, currentMinRow, currentMaxRow)
            currentMinRow := newMinRow
            currentMaxRow := newMaxRow
            currentOverflow := currentOverflow or blockOverflow
            if not na(lastCommittedBlockHigh)
                currentRotationFactor += activeBlockHigh > lastCommittedBlockHigh ? 1.0 : activeBlockHigh < lastCommittedBlockHigh ? -1.0 : 0.0
                currentRotationFactor += activeBlockLow > lastCommittedBlockLow ? 1.0 : activeBlockLow < lastCommittedBlockLow ? -1.0 : 0.0
            currentCommittedBlocks += 1
            lastCommittedBlockHigh := activeBlockHigh
            lastCommittedBlockLow := activeBlockLow
        currentClose := bar_index > 0 ? close[1] : close
        currentSessionEndBar := bar_index > 0 ? bar_index - 1 : bar_index
        currentComplete := true

        previousTpo := currentTpo.copy()
        previousEstimatedVolume := currentEstimatedVolume.copy()
        previousRowSize := currentRowSize
        previousMinRow := currentMinRow
        previousMaxRow := currentMaxRow
        previousSessionStartBar := currentSessionStartBar
        previousSessionEndBar := currentSessionEndBar
        previousOpen := currentOpen
        previousClose := currentClose
        previousHigh := currentHigh
        previousLow := currentLow
        previousIbHigh := currentIbHigh
        previousIbLow := currentIbLow
        previousRotationFactor := currentRotationFactor
        previousCommittedBlocks := currentCommittedBlocks
        previousOverflow := currentOverflow
        previousHasData := currentTpo.size() > 0

    float previousRangeForSizing = previousHasData and not na(previousHigh) and not na(previousLow) ? previousHigh - previousLow : na
    currentRowSize := f_choose_ticks(previousRangeForSizing) * syminfo.mintick
    currentTpo := map.new<int, int>()
    currentEstimatedVolume := map.new<int, float>()
    currentMinRow := int(na)
    currentMaxRow := int(na)
    currentHasData := true
    currentComplete := false
    currentOverflow := false
    currentSessionStartBar := bar_index
    currentSessionEndBar := int(na)
    currentOpen := open
    currentClose := na
    currentHigh := high
    currentLow := low
    currentIbHigh := na
    currentIbLow := na
    currentRotationFactor := 0.0
    currentCommittedBlocks := 0
    activeBlockId := -1
    activeBlockHigh := na
    activeBlockLow := na
    lastCommittedBlockHigh := na
    lastCommittedBlockLow := na

if inRTH and currentHasData and not na(currentRowSize)
    currentHigh := na(currentHigh) ? high : math.max(currentHigh, high)
    currentLow := na(currentLow) ? low : math.min(currentLow, low)

    if currentBlockId >= 0 and currentBlockId < initialBalanceBlocks
        currentIbHigh := na(currentIbHigh) ? high : math.max(currentIbHigh, high)
        currentIbLow := na(currentIbLow) ? low : math.min(currentIbLow, low)

    if activeBlockId < 0
        activeBlockId := currentBlockId
        activeBlockHigh := high
        activeBlockLow := low
    else if currentBlockId != activeBlockId
        int completedLowRow = int(math.floor(activeBlockLow / currentRowSize))
        int completedHighRow = int(math.floor(activeBlockHigh / currentRowSize))
        [newMinRow, newMaxRow, blockOverflow] = f_add_tpo_block(currentTpo, completedLowRow, completedHighRow, currentMinRow, currentMaxRow)
        currentMinRow := newMinRow
        currentMaxRow := newMaxRow
        currentOverflow := currentOverflow or blockOverflow
        if not na(lastCommittedBlockHigh)
            currentRotationFactor += activeBlockHigh > lastCommittedBlockHigh ? 1.0 : activeBlockHigh < lastCommittedBlockHigh ? -1.0 : 0.0
            currentRotationFactor += activeBlockLow > lastCommittedBlockLow ? 1.0 : activeBlockLow < lastCommittedBlockLow ? -1.0 : 0.0
        currentCommittedBlocks += 1
        lastCommittedBlockHigh := activeBlockHigh
        lastCommittedBlockLow := activeBlockLow
        activeBlockId := currentBlockId
        activeBlockHigh := high
        activeBlockLow := low
    else
        activeBlockHigh := math.max(activeBlockHigh, high)
        activeBlockLow := math.min(activeBlockLow, low)

    if barstate.isconfirmed and showEstimatedVolume
        int barLowRow = int(math.floor(low / currentRowSize))
        int barHighRow = int(math.floor(high / currentRowSize))
        bool volumeOverflow = f_add_estimated_volume(currentEstimatedVolume, barLowRow, barHighRow, volume)
        currentOverflow := currentOverflow or volumeOverflow

if endRTH and currentHasData and activeBlockId >= 0 and not na(currentRowSize)
    int finalLowRow = int(math.floor(activeBlockLow / currentRowSize))
    int finalHighRow = int(math.floor(activeBlockHigh / currentRowSize))
    [newMinRow, newMaxRow, blockOverflow] = f_add_tpo_block(currentTpo, finalLowRow, finalHighRow, currentMinRow, currentMaxRow)
    currentMinRow := newMinRow
    currentMaxRow := newMaxRow
    currentOverflow := currentOverflow or blockOverflow
    if not na(lastCommittedBlockHigh)
        currentRotationFactor += activeBlockHigh > lastCommittedBlockHigh ? 1.0 : activeBlockHigh < lastCommittedBlockHigh ? -1.0 : 0.0
        currentRotationFactor += activeBlockLow > lastCommittedBlockLow ? 1.0 : activeBlockLow < lastCommittedBlockLow ? -1.0 : 0.0
    currentCommittedBlocks += 1
    lastCommittedBlockHigh := activeBlockHigh
    lastCommittedBlockLow := activeBlockLow
    currentClose := close[1]
    currentSessionEndBar := bar_index - 1
    currentComplete := true
    activeBlockId := -1
    activeBlockHigh := na
    activeBlockLow := na

int activeLowRow = inRTH and activeBlockId >= 0 and not na(activeBlockLow) and not na(currentRowSize) ? int(math.floor(activeBlockLow / currentRowSize)) : int(na)
int activeHighRow = inRTH and activeBlockId >= 0 and not na(activeBlockHigh) and not na(currentRowSize) ? int(math.floor(activeBlockHigh / currentRowSize)) : int(na)
bool includeActiveBlock = inRTH and activeBlockId >= 0 and not na(activeLowRow) and not na(activeHighRow)
int displayCurrentMinRow = includeActiveBlock ? (na(currentMinRow) ? activeLowRow : math.min(currentMinRow, activeLowRow)) : currentMinRow
int displayCurrentMaxRow = includeActiveBlock ? (na(currentMaxRow) ? activeHighRow : math.max(currentMaxRow, activeHighRow)) : currentMaxRow

[curValid, curPocRow, curVahRow, curValRow, curTotalTpo, curTpoAbove, curTpoBelow, curSingleRows, curMaxCount, curPoorHigh, curPoorLow, curMeanRow, curSkewness, curProfileHigh, curProfileLow, curProfileMid, curPoc, curVah, curVal] =
     f_tpo_stats(currentTpo, displayCurrentMinRow, displayCurrentMaxRow, currentRowSize, includeActiveBlock, activeLowRow, activeHighRow, valueAreaPercent)

[prevValid, prevPocRow, prevVahRow, prevValRow, prevTotalTpo, prevTpoAbove, prevTpoBelow, prevSingleRows, prevMaxCount, prevPoorHigh, prevPoorLow, prevMeanRow, prevSkewness, prevProfileHigh, prevProfileLow, prevProfileMid, prevPoc, prevVah, prevVal] =
     f_tpo_stats(previousTpo, previousMinRow, previousMaxRow, previousRowSize, false, int(na), int(na), valueAreaPercent)

[curVolumeValid, curVolumePocRow, curVolumeVahRow, curVolumeValRow, curTotalEstimatedVolume, curMaxEstimatedVolume, curVolumePoc, curVolumeVah, curVolumeVal] =
     f_volume_stats(currentEstimatedVolume, displayCurrentMinRow, displayCurrentMaxRow, currentRowSize, estimatedVolumeValueArea)

float currentIbRange = not na(currentIbHigh) and not na(currentIbLow) ? currentIbHigh - currentIbLow : na
float currentProfileRange = curValid ? curProfileHigh - curProfileLow : na

[curShapeCode, curShapeText, curDoubleDistribution] = f_profile_shape(
     currentTpo, displayCurrentMinRow, displayCurrentMaxRow, includeActiveBlock, activeLowRow, activeHighRow,
     curPocRow, curSkewness, currentProfileRange, currentIbRange)

string valueRelationship = not curValid or not prevValid ? "No Comparison" :
     curVal > prevVah ? "Higher Value" :
     curVah < prevVal ? "Lower Value" :
     curVah > prevVah and curVal > prevVal ? "Overlapping Higher" :
     curVah < prevVah and curVal < prevVal ? "Overlapping Lower" :
     curVah <= prevVah and curVal >= prevVal ? "Inside Prior Value" :
     curVah >= prevVah and curVal <= prevVal ? "Outside Prior Value" : "Overlapping Value"

float pocMigrationRows = curValid and prevValid ? (curPoc - prevPoc) / math.max(currentRowSize, syminfo.mintick) : na
string pocMigration = na(pocMigrationRows) ? "No Comparison" :
     pocMigrationRows >= strongPocMigrationRows ? "Strongly Higher" :
     pocMigrationRows > 0.5 ? "Higher" :
     pocMigrationRows <= -strongPocMigrationRows ? "Strongly Lower" :
     pocMigrationRows < -0.5 ? "Lower" : "Stable"

string openingLocation = not prevValid or na(currentOpen) ? "No Prior Profile" :
     currentOpen > prevProfileHigh ? "Above Prior Range" :
     currentOpen > prevVah ? "Above Prior Value" :
     currentOpen >= prevVal ? "Inside Prior Value" :
     currentOpen >= prevProfileLow ? "Below Prior Value" : "Below Prior Range"

string currentLocation = not curValid ? "No Profile" :
     close > curProfileHigh ? "Above Profile" :
     close > curVah ? "Above Value" :
     math.abs(close - curPoc) <= currentRowSize ? "At POC" :
     close >= curVal ? "Inside Value" :
     close >= curProfileLow ? "Below Value" : "Below Profile"

bool upwardValue = str.contains(valueRelationship, "Higher")
bool downwardValue = str.contains(valueRelationship, "Lower")
bool pocUp = str.contains(pocMigration, "Higher")
bool pocDown = str.contains(pocMigration, "Lower")
bool aboveIb = not na(currentIbHigh) and close > currentIbHigh
bool belowIb = not na(currentIbLow) and close < currentIbLow
bool returnedInsidePriorValue = prevValid and close <= prevVah and close >= prevVal
bool openedAbovePriorValue = prevValid and currentOpen > prevVah
bool openedBelowPriorValue = prevValid and currentOpen < prevVal

string participantBehavior = curShapeCode == 1 and currentLocation == "Inside Value" ? "Two-sided Trade" :
     openedAbovePriorValue and returnedInsidePriorValue ? "Responsive Selling" :
     openedBelowPriorValue and returnedInsidePriorValue ? "Responsive Buying" :
     upwardValue and pocUp and (aboveIb or close > curVah) ? "Initiative Buying" :
     downwardValue and pocDown and (belowIb or close < curVal) ? "Initiative Selling" :
     "Indeterminate"

int auctionCode = 0
string auctionState = "Transition"
if curDoubleDistribution
    auctionCode := 4
    auctionState := "Double Distribution"
else if openedAbovePriorValue and returnedInsidePriorValue and not pocUp
    auctionCode := -3
    auctionState := "Failed Upward Auction"
else if openedBelowPriorValue and returnedInsidePriorValue and not pocDown
    auctionCode := 3
    auctionState := "Failed Downward Auction"
else if curShapeCode == 5 and upwardValue and pocUp
    auctionCode := 2
    auctionState := "Upward Trend Auction"
else if curShapeCode == 5 and downwardValue and pocDown
    auctionCode := -2
    auctionState := "Downward Trend Auction"
else if upwardValue and pocUp and close >= curPoc
    auctionCode := 1
    auctionState := "Upward Imbalance"
else if downwardValue and pocDown and close <= curPoc
    auctionCode := -1
    auctionState := "Downward Imbalance"
else if curShapeCode == 1 and currentLocation == "Inside Value"
    auctionCode := 5
    auctionState := "Balanced Auction"
else if curValid and close >= curVal and close <= curVah
    auctionCode := 6
    auctionState := "Developing Balance"

color auctionColor = auctionCode == 1 or auctionCode == 2 or auctionCode == 3 ? bullishColor :
     auctionCode == -1 or auctionCode == -2 or auctionCode == -3 ? bearishColor :
     auctionCode == 4 ? accentColor : auctionCode == 5 or auctionCode == 6 ? secondaryColor : neutralColor

color migrationColor = upwardValue or pocUp ? bullishColor : downwardValue or pocDown ? bearishColor : neutralColor

var int[] previousSingleZoneStarts = array.new_int()
var int[] previousSingleZoneEnds = array.new_int()
array.clear(previousSingleZoneStarts)
array.clear(previousSingleZoneEnds)

if prevValid
    int zoneStart = int(na)
    for row = previousMinRow to previousMaxRow
        int rowCount = f_int_get(previousTpo, row)
        bool isSingle = row > previousMinRow and row < previousMaxRow and rowCount == 1
        if isSingle and na(zoneStart)
            zoneStart := row
        bool closesZone = not isSingle and not na(zoneStart)
        if closesZone
            previousSingleZoneStarts.push(zoneStart)
            previousSingleZoneEnds.push(row - 1)
            zoneStart := int(na)
    if not na(zoneStart)
        previousSingleZoneStarts.push(zoneStart)
        previousSingleZoneEnds.push(previousMaxRow - 1)

bool previousPocTouched = inRTH and prevValid and high >= prevPoc and low <= prevPoc
bool previousVahTouched = inRTH and prevValid and high >= prevVah and low <= prevVah
bool previousValTouched = inRTH and prevValid and high >= prevVal and low <= prevVal

var int previousPocState = 0
var int previousVahState = 0
var int previousValState = 0
if newRTH
    previousPocState := 0
    previousVahState := 0
    previousValState := 0
float closesAbovePocCount = math.sum(prevValid and close > prevPoc ? 1.0 : 0.0, acceptanceCloses)
float closesBelowPocCount = math.sum(prevValid and close < prevPoc ? 1.0 : 0.0, acceptanceCloses)
float closesAboveVahCount = math.sum(prevValid and close > prevVah ? 1.0 : 0.0, acceptanceCloses)
float closesBelowValCount = math.sum(prevValid and close < prevVal ? 1.0 : 0.0, acceptanceCloses)
bool closesAbovePoc = prevValid and closesAbovePocCount >= acceptanceCloses
bool closesBelowPoc = prevValid and closesBelowPocCount >= acceptanceCloses
bool closesAboveVah = prevValid and closesAboveVahCount >= acceptanceCloses
bool closesBelowVal = prevValid and closesBelowValCount >= acceptanceCloses
if barstate.isconfirmed and inRTH and prevValid
    if closesAbovePoc
        previousPocState := 1
    else if closesBelowPoc
        previousPocState := -1
    else if previousPocTouched
        previousPocState := close >= prevPoc ? 2 : -2
    if closesAboveVah
        previousVahState := 1
    else if previousVahTouched and close < prevVah
        previousVahState := -2
    if closesBelowVal
        previousValState := -1
    else if previousValTouched and close > prevVal
        previousValState := 2

bool poorHighRepaired = inRTH and prevValid and prevPoorHigh and high > prevProfileHigh
bool poorLowRepaired = inRTH and prevValid and prevPoorLow and low < prevProfileLow
bool previousSinglePrintOverlap = false
if inRTH and prevValid and previousSingleZoneStarts.size() > 0
    for zoneIndex = 0 to previousSingleZoneStarts.size() - 1
        int startRow = previousSingleZoneStarts.get(zoneIndex)
        int endRow = previousSingleZoneEnds.get(zoneIndex)
        float zoneLow = f_row_low(startRow, previousRowSize)
        float zoneHigh = f_row_high(endRow, previousRowSize)
        previousSinglePrintOverlap := previousSinglePrintOverlap or (high >= zoneLow and low <= zoneHigh)

var array<box> currentProfileBoxes = array.new<box>()
var array<box> previousProfileBoxes = array.new<box>()
var array<box> estimatedVolumeBoxes = array.new<box>()
var array<box> singlePrintBoxes = array.new<box>()
var array<label> rowCountLabels = array.new<label>()
var array<label> profileNameLabels = array.new<label>()

if barstate.islast
    int currentLeft = bar_index + profileOffsetBars
    int estimatedVolumeLeft = currentLeft + maximumProfileWidthBars + 1
    int previousLeft = currentLeft + maximumProfileWidthBars + (showEstimatedVolume ? estimatedVolumeWidthBars + 2 : 0) + profileGapBars

    int currentUsed = 0
    int rowLabelsUsed = 0
    if indicatorEnabled and showCurrentProfile and curValid
        int currentRows = displayCurrentMaxRow - displayCurrentMinRow + 1
        int currentStride = math.max(1, int(math.ceil(currentRows / maximumRenderedRows)))
        int groupCount = int(math.ceil(currentRows / currentStride))
        int groupedMaxCount = 1
        for groupIndex = 0 to groupCount - 1
            int groupLowRow = displayCurrentMinRow + groupIndex * currentStride
            int groupHighRow = math.min(groupLowRow + currentStride - 1, displayCurrentMaxRow)
            int groupMaximum = 0
            for row = groupLowRow to groupHighRow
                groupMaximum := math.max(groupMaximum, f_tpo_count(currentTpo, row, includeActiveBlock, activeLowRow, activeHighRow))
            groupedMaxCount := math.max(groupedMaxCount, groupMaximum)

        for groupIndex = 0 to groupCount - 1
            int groupLowRow = displayCurrentMinRow + groupIndex * currentStride
            int groupHighRow = math.min(groupLowRow + currentStride - 1, displayCurrentMaxRow)
            int groupMaximum = 0
            bool groupSinglePrint = false
            for row = groupLowRow to groupHighRow
                int rowCount = f_tpo_count(currentTpo, row, includeActiveBlock, activeLowRow, activeHighRow)
                groupMaximum := math.max(groupMaximum, rowCount)
                groupSinglePrint := groupSinglePrint or (row > displayCurrentMinRow and row < displayCurrentMaxRow and rowCount == 1)
            int profileWidth = math.max(1, int(math.round(groupMaximum / math.max(groupedMaxCount, 1.0) * maximumProfileWidthBars)))
            bool isValue = groupHighRow >= curValRow and groupLowRow <= curVahRow
            bool isPoc = groupHighRow >= curPocRow and groupLowRow <= curPocRow
            color baseColor = isPoc ? pocColor : groupSinglePrint ? singlePrintColor : isValue and showValueAreaShading ? valueAreaColor : outsideValueColor
            int transparency = isPoc ? math.max(profileTransparency - 12, 0) : profileTransparency
            f_set_box(currentProfileBoxes, currentUsed, currentLeft, f_row_high(groupHighRow, currentRowSize), currentLeft + profileWidth, f_row_low(groupLowRow, currentRowSize), color.new(baseColor, math.min(transparency + 10, 100)), color.new(baseColor, transparency))
            currentUsed += 1
            if showRowCounts
                f_set_label(rowCountLabels, rowLabelsUsed, currentLeft + profileWidth + 1, (f_row_high(groupHighRow, currentRowSize) + f_row_low(groupLowRow, currentRowSize)) * 0.5, str.tostring(groupMaximum), color.new(panelColor, 100), color.new(textColor, 12), "None", "Tiny")
                rowLabelsUsed += 1
    f_trim_boxes(currentProfileBoxes, currentUsed)

    int previousUsed = 0
    if indicatorEnabled and showPreviousProfile and prevValid
        int previousRows = previousMaxRow - previousMinRow + 1
        int previousStride = math.max(1, int(math.ceil(previousRows / maximumRenderedRows)))
        int groupCount = int(math.ceil(previousRows / previousStride))
        int groupedMaxCount = 1
        for groupIndex = 0 to groupCount - 1
            int groupLowRow = previousMinRow + groupIndex * previousStride
            int groupHighRow = math.min(groupLowRow + previousStride - 1, previousMaxRow)
            int groupMaximum = 0
            for row = groupLowRow to groupHighRow
                groupMaximum := math.max(groupMaximum, f_int_get(previousTpo, row))
            groupedMaxCount := math.max(groupedMaxCount, groupMaximum)
        for groupIndex = 0 to groupCount - 1
            int groupLowRow = previousMinRow + groupIndex * previousStride
            int groupHighRow = math.min(groupLowRow + previousStride - 1, previousMaxRow)
            int groupMaximum = 0
            bool groupSinglePrint = false
            for row = groupLowRow to groupHighRow
                int rowCount = f_int_get(previousTpo, row)
                groupMaximum := math.max(groupMaximum, rowCount)
                groupSinglePrint := groupSinglePrint or (row > previousMinRow and row < previousMaxRow and rowCount == 1)
            int profileWidth = math.max(1, int(math.round(groupMaximum / math.max(groupedMaxCount, 1.0) * maximumProfileWidthBars)))
            bool isValue = groupHighRow >= prevValRow and groupLowRow <= prevVahRow
            bool isPoc = groupHighRow >= prevPocRow and groupLowRow <= prevPocRow
            color baseColor = isPoc ? color.new(pocColor, 15) : groupSinglePrint ? color.new(singlePrintColor, 12) : isValue and showValueAreaShading ? previousValueColor : previousOutsideColor
            f_set_box(previousProfileBoxes, previousUsed, previousLeft, f_row_high(groupHighRow, previousRowSize), previousLeft + profileWidth, f_row_low(groupLowRow, previousRowSize), color.new(baseColor, math.min(previousProfileTransparency + 10, 100)), color.new(baseColor, previousProfileTransparency))
            previousUsed += 1
    f_trim_boxes(previousProfileBoxes, previousUsed)

    int volumeUsed = 0
    if indicatorEnabled and showEstimatedVolume and curVolumeValid
        int currentRows = displayCurrentMaxRow - displayCurrentMinRow + 1
        int currentStride = math.max(1, int(math.ceil(currentRows / maximumRenderedRows)))
        int groupCount = int(math.ceil(currentRows / currentStride))
        float groupedMaximumVolume = 1.0
        for groupIndex = 0 to groupCount - 1
            int groupLowRow = displayCurrentMinRow + groupIndex * currentStride
            int groupHighRow = math.min(groupLowRow + currentStride - 1, displayCurrentMaxRow)
            float groupVolume = 0.0
            for row = groupLowRow to groupHighRow
                groupVolume += f_float_get(currentEstimatedVolume, row)
            groupedMaximumVolume := math.max(groupedMaximumVolume, groupVolume)
        for groupIndex = 0 to groupCount - 1
            int groupLowRow = displayCurrentMinRow + groupIndex * currentStride
            int groupHighRow = math.min(groupLowRow + currentStride - 1, displayCurrentMaxRow)
            float groupVolume = 0.0
            for row = groupLowRow to groupHighRow
                groupVolume += f_float_get(currentEstimatedVolume, row)
            int volumeWidth = math.max(1, int(math.round(groupVolume / groupedMaximumVolume * estimatedVolumeWidthBars)))
            bool isValue = groupHighRow >= curVolumeValRow and groupLowRow <= curVolumeVahRow
            bool isPoc = groupHighRow >= curVolumePocRow and groupLowRow <= curVolumePocRow
            color volumeColor = isPoc ? pocColor : isValue ? secondaryColor : neutralColor
            f_set_box(estimatedVolumeBoxes, volumeUsed, estimatedVolumeLeft, f_row_high(groupHighRow, currentRowSize), estimatedVolumeLeft + volumeWidth, f_row_low(groupLowRow, currentRowSize), color.new(volumeColor, 65), color.new(volumeColor, isPoc ? 24 : 56))
            volumeUsed += 1
    f_trim_boxes(estimatedVolumeBoxes, volumeUsed)
    f_trim_labels(rowCountLabels, rowLabelsUsed)

    int nameLabelsUsed = 0
    if indicatorEnabled and showProfileNames and curValid and showCurrentProfile
        f_set_label(profileNameLabels, nameLabelsUsed, currentLeft, curProfileHigh + currentRowSize, "CURRENT TPO", color.new(accentColor, 68), textColor, "Left", "Tiny")
        nameLabelsUsed += 1
    if indicatorEnabled and showProfileNames and prevValid and showPreviousProfile
        f_set_label(profileNameLabels, nameLabelsUsed, previousLeft, prevProfileHigh + previousRowSize, "PREVIOUS TPO", color.new(previousValueColor, 66), textColor, "Left", "Tiny")
        nameLabelsUsed += 1
    if indicatorEnabled and showProfileNames and showEstimatedVolume and curVolumeValid
        f_set_label(profileNameLabels, nameLabelsUsed, estimatedVolumeLeft, curProfileHigh + currentRowSize, "EST. VOLUME", color.new(secondaryColor, 68), textColor, "Left", "Tiny")
        nameLabelsUsed += 1
    f_trim_labels(profileNameLabels, nameLabelsUsed)

    int singleZonesUsed = 0
    if indicatorEnabled and showSinglePrintZones and prevValid and inRTH and previousSingleZoneStarts.size() > 0
        int zonesToDraw = math.min(previousSingleZoneStarts.size(), maximumSinglePrintZones)
        for zoneIndex = 0 to zonesToDraw - 1
            int startRow = previousSingleZoneStarts.get(zoneIndex)
            int endRow = previousSingleZoneEnds.get(zoneIndex)
            float zoneLow = f_row_low(startRow, previousRowSize)
            float zoneHigh = f_row_high(endRow, previousRowSize)
            bool touched = currentHigh >= zoneLow and currentLow <= zoneHigh
            bool repaired = currentHigh >= zoneHigh and currentLow <= zoneLow
            color zoneColor = repaired ? neutralColor : touched ? poorColor : singlePrintColor
            int zoneLeft = na(previousSessionEndBar) ? bar_index - 1 : previousSessionEndBar
            int zoneRight = bar_index + levelExtensionBars
            f_set_box(singlePrintBoxes, singleZonesUsed, zoneLeft, zoneHigh, zoneRight, zoneLow, color.new(zoneColor, 42), color.new(zoneColor, repaired ? 92 : touched ? 86 : 78))
            singleZonesUsed += 1
    f_trim_boxes(singlePrintBoxes, singleZonesUsed)

var array<line> keyLines = array.new<line>()
var array<label> keyLabels = array.new<label>()

f_set_level(
     array<line> lineObjects,
     array<label> labelObjects,
     int index,
     bool enabled,
     int startX,
     int endX,
     float price,
     string name,
     color levelColor,
     string styleValue,
     int widthValue) =>
    line levelLine = index < lineObjects.size() ? lineObjects.get(index) : na
    label levelLabel = index < labelObjects.size() ? labelObjects.get(index) : na
    if enabled and not na(price)
        if na(levelLine)
            levelLine := line.new(startX, price, endX, price, xloc = xloc.bar_index, extend = extend.none, color = levelColor, style = styleValue, width = widthValue)
            if index < lineObjects.size()
                lineObjects.set(index, levelLine)
            else
                lineObjects.push(levelLine)
        else
            line.set_xy1(levelLine, startX, price)
            line.set_xy2(levelLine, endX, price)
            line.set_color(levelLine, levelColor)
            line.set_style(levelLine, styleValue)
            line.set_width(levelLine, widthValue)
        if na(levelLabel)
            levelLabel := label.new(endX, price, name, xloc = xloc.bar_index, style = label.style_label_left, color = color.new(levelColor, 82), textcolor = textColor, size = size.tiny)
            if index < labelObjects.size()
                labelObjects.set(index, levelLabel)
            else
                labelObjects.push(levelLabel)
        else
            label.set_xy(levelLabel, endX, price)
            label.set_text(levelLabel, name)
            label.set_color(levelLabel, color.new(levelColor, 82))
            label.set_textcolor(levelLabel, textColor)
    else
        if not na(levelLine)
            line.delete(levelLine)
            lineObjects.set(index, line(na))
        if not na(levelLabel)
            label.delete(levelLabel)
            labelObjects.set(index, label(na))

if barstate.islast
    while keyLines.size() < 20
        keyLines.push(line(na))
    while keyLabels.size() < 20
        keyLabels.push(label(na))

    int currentLevelEnd = bar_index + profileOffsetBars
    int previousLevelEnd = bar_index + levelExtensionBars
    int currentStart = na(currentSessionStartBar) ? bar_index : currentSessionStartBar
    int previousStart = na(previousSessionEndBar) ? bar_index : previousSessionEndBar
    string previousStyle = f_line_style(levelLineStyle)

    f_set_level(keyLines, keyLabels, 0, indicatorEnabled and showCurrentLevels and curValid, currentStart, currentLevelEnd, curPoc, "TPO POC", pocColor, line.style_solid, 2)
    f_set_level(keyLines, keyLabels, 1, indicatorEnabled and showCurrentLevels and curValid, currentStart, currentLevelEnd, curVah, "TPO VAH", developingColor, line.style_dashed, levelLineWidth)
    f_set_level(keyLines, keyLabels, 2, indicatorEnabled and showCurrentLevels and curValid, currentStart, currentLevelEnd, curVal, "TPO VAL", developingColor, line.style_dashed, levelLineWidth)
    f_set_level(keyLines, keyLabels, 3, indicatorEnabled and showProfileMidpoint and curValid, currentStart, currentLevelEnd, curProfileMid, "TPO MID", color.new(accentColor, 18), line.style_dotted, 1)
    f_set_level(keyLines, keyLabels, 4, indicatorEnabled and showInitialBalance and not na(currentIbHigh), currentStart, currentLevelEnd, currentIbHigh, "IBH", color.new(secondaryColor, 8), line.style_solid, levelLineWidth)
    f_set_level(keyLines, keyLabels, 5, indicatorEnabled and showInitialBalance and not na(currentIbLow), currentStart, currentLevelEnd, currentIbLow, "IBL", color.new(secondaryColor, 8), line.style_solid, levelLineWidth)

    color prevPocColor = previousPocState == 1 or previousPocState == 2 ? bullishColor : previousPocState == -1 or previousPocState == -2 ? bearishColor : previousPocTouched ? poorColor : previousValueColor
    color prevVahColor = previousVahState == 1 ? bullishColor : previousVahState == -2 ? bearishColor : previousVahTouched ? poorColor : previousValueColor
    color prevValColor = previousValState == 2 ? bullishColor : previousValState == -1 ? bearishColor : previousValTouched ? poorColor : previousValueColor
    string prevPocText = previousPocState == 1 ? "PRIOR POC · ACCEPTED ABOVE" : previousPocState == -1 ? "PRIOR POC · ACCEPTED BELOW" : previousPocState == 2 ? "PRIOR POC · RECLAIMED" : previousPocState == -2 ? "PRIOR POC · LOST" : "PRIOR POC"
    string prevVahText = previousVahState == 1 ? "PRIOR VAH · ACCEPTED ABOVE" : previousVahState == -2 ? "PRIOR VAH · REJECTED" : "PRIOR VAH"
    string prevValText = previousValState == -1 ? "PRIOR VAL · ACCEPTED BELOW" : previousValState == 2 ? "PRIOR VAL · RECLAIMED" : "PRIOR VAL"
    f_set_level(keyLines, keyLabels, 6, indicatorEnabled and extendPreviousLevels and prevValid, previousStart, previousLevelEnd, prevPoc, prevPocText, prevPocColor, previousStyle, levelLineWidth)
    f_set_level(keyLines, keyLabels, 7, indicatorEnabled and extendPreviousLevels and prevValid, previousStart, previousLevelEnd, prevVah, prevVahText, prevVahColor, previousStyle, levelLineWidth)
    f_set_level(keyLines, keyLabels, 8, indicatorEnabled and extendPreviousLevels and prevValid, previousStart, previousLevelEnd, prevVal, prevValText, prevValColor, previousStyle, levelLineWidth)
    f_set_level(keyLines, keyLabels, 9, indicatorEnabled and showPoorHighLow and prevValid and prevPoorHigh, previousStart, previousLevelEnd, prevProfileHigh, poorHighRepaired ? "POOR HIGH · REPAIRED" : "POOR HIGH", poorHighRepaired ? neutralColor : poorColor, line.style_dotted, levelLineWidth)
    f_set_level(keyLines, keyLabels, 10, indicatorEnabled and showPoorHighLow and prevValid and prevPoorLow, previousStart, previousLevelEnd, prevProfileLow, poorLowRepaired ? "POOR LOW · REPAIRED" : "POOR LOW", poorLowRepaired ? neutralColor : poorColor, line.style_dotted, levelLineWidth)
    f_set_level(keyLines, keyLabels, 11, indicatorEnabled and showEstimatedVolume and showEstimatedVolumeLevels and curVolumeValid, currentStart, currentLevelEnd, curVolumePoc, "EST. VPOC", secondaryColor, line.style_solid, 1)
    f_set_level(keyLines, keyLabels, 12, indicatorEnabled and showEstimatedVolume and showEstimatedVolumeLevels and curVolumeValid, currentStart, currentLevelEnd, curVolumeVah, "EST. VVAH", color.new(secondaryColor, 18), line.style_dashed, 1)
    f_set_level(keyLines, keyLabels, 13, indicatorEnabled and showEstimatedVolume and showEstimatedVolumeLevels and curVolumeValid, currentStart, currentLevelEnd, curVolumeVal, "EST. VVAL", color.new(secondaryColor, 18), line.style_dashed, 1)
    float liveSessionClose = inRTH ? close : currentClose
    f_set_level(keyLines, keyLabels, 14, indicatorEnabled and showSessionOpenClose and not na(currentOpen), currentStart, currentLevelEnd, currentOpen, "RTH OPEN", color.new(textColor, 28), line.style_solid, 1)
    f_set_level(keyLines, keyLabels, 15, indicatorEnabled and showSessionOpenClose and not na(liveSessionClose), currentStart, currentLevelEnd, liveSessionClose, inRTH ? "LIVE CLOSE" : "RTH CLOSE", color.new(neutralColor, 22), line.style_dotted, 1)
    float ibRangeForExtensions = not na(currentIbHigh) and not na(currentIbLow) ? currentIbHigh - currentIbLow : na
    f_set_level(keyLines, keyLabels, 16, indicatorEnabled and showIbExtensions and not na(ibRangeForExtensions), currentStart, currentLevelEnd, currentIbHigh + ibRangeForExtensions * firstIbExtension, "IB +" + str.tostring(firstIbExtension, "#.##"), color.new(secondaryColor, 24), line.style_dashed, 1)
    f_set_level(keyLines, keyLabels, 17, indicatorEnabled and showIbExtensions and not na(ibRangeForExtensions), currentStart, currentLevelEnd, currentIbLow - ibRangeForExtensions * firstIbExtension, "IB -" + str.tostring(firstIbExtension, "#.##"), color.new(secondaryColor, 24), line.style_dashed, 1)
    f_set_level(keyLines, keyLabels, 18, indicatorEnabled and showIbExtensions and not na(ibRangeForExtensions), currentStart, currentLevelEnd, currentIbHigh + ibRangeForExtensions * secondIbExtension, "IB +" + str.tostring(secondIbExtension, "#.##"), color.new(secondaryColor, 42), line.style_dotted, 1)
    f_set_level(keyLines, keyLabels, 19, indicatorEnabled and showIbExtensions and not na(ibRangeForExtensions), currentStart, currentLevelEnd, currentIbLow - ibRangeForExtensions * secondIbExtension, "IB -" + str.tostring(secondIbExtension, "#.##"), color.new(secondaryColor, 42), line.style_dotted, 1)

string structureState = not curValid ? "No Profile" :
     curPoorHigh and curPoorLow ? "Poor High + Low" :
     curPoorHigh ? "Poor High" :
     curPoorLow ? "Poor Low" :
     curSingleRows > 0 ? str.tostring(curSingleRows) + " Single Rows" : "Clean Extremes"

string ibState = not curValid or na(currentIbHigh) or na(currentIbLow) ? "IB Developing" :
     close > currentIbHigh ? "Above IB" : close < currentIbLow ? "Below IB" : "Inside IB"

string valueDetail = pocMigration + " POC\nVA " + str.tostring(curVah - curVal, format.mintick)
string profileDetail = "Skew " + str.tostring(curSkewness, "#.##") + " · RF " + str.tostring(currentRotationFactor, "#.0")
string structureDetail = "Singles " + str.tostring(curSingleRows) + " · TPO " + str.tostring(curTotalTpo)
string locationDetail = currentLocation + "\n" + ibState
string openDetail = openingLocation + "\nOpen " + (na(currentOpen) ? "—" : str.tostring(currentOpen, format.mintick))

var table dashboard = table.new(
     f_dashboard_position(dashboardWithFuturesLevels, dashboardPosition), 2, 5,
     bgcolor = color.new(panelColor, 100),
     frame_color = color.new(accentColor, 100), frame_width = 1,
     border_color = color.new(neutralColor, 100), border_width = 1)

if barstate.isfirst
    table.merge_cells(dashboard, 0, 0, 1, 0)
    table.merge_cells(dashboard, 0, 4, 1, 4)

if barstate.islast
    bool visible = indicatorEnabled and showDashboard
    color invisible = color.new(panelColor, 100)
    color dashboardBackground = visible ? color.new(panelColor, 8) : invisible
    color dashboardText = visible ? textColor : color.new(textColor, 100)
    color dashboardMuted = visible ? color.new(textColor, 25) : color.new(textColor, 100)
    string layoutTag = dashboardWithFuturesLevels ? "Stacked" : "Standalone"
    string footer = chartWarning ? "Use standard intraday candles with chart timeframe ≤ TPO block size" :
         (currentOverflow or previousOverflow ? "Row-density warning · Increase ticks per row" : "RTH · " + blockSizeInput + " · " + str.tostring(int(math.round(currentRowSize / syminfo.mintick))) + " ticks/row · " + layoutTag)

    table.set_bgcolor(dashboard, dashboardBackground)
    table.set_frame_color(dashboard, visible ? color.new(accentColor, 28) : color.new(accentColor, 100))
    table.set_border_color(dashboard, visible ? color.new(neutralColor, 82) : color.new(neutralColor, 100))

    table.cell(dashboard, 0, 0, "MERIDIAN  —  FUTURES PROFILE",
         width = dashboardColumnWidth * 2, height = dashboardHeaderHeight,
         bgcolor = visible ? color.new(accentColor, 14) : invisible,
         text_color = dashboardText, text_size = f_text_size(dashboardTextSize), text_halign = text.align_center)

    table.cell(dashboard, 0, 1, "AUCTION\n" + auctionState + "\n" + participantBehavior,
         width = dashboardColumnWidth, height = dashboardCardHeight,
         bgcolor = visible ? color.new(auctionColor, 78) : invisible,
         text_color = dashboardText, text_size = f_text_size(dashboardTextSize), text_halign = text.align_left, text_valign = text.align_center)
    table.cell(dashboard, 1, 1, "VALUE\n" + valueRelationship + "\n" + valueDetail,
         width = dashboardColumnWidth, height = dashboardCardHeight,
         bgcolor = visible ? color.new(migrationColor, 82) : invisible,
         text_color = dashboardText, text_size = f_text_size(dashboardTextSize), text_halign = text.align_left, text_valign = text.align_center)

    table.cell(dashboard, 0, 2, "PROFILE SHAPE\n" + curShapeText + "\n" + profileDetail,
         width = dashboardColumnWidth, height = dashboardCardHeight,
         bgcolor = visible ? color.new(accentColor, 84) : invisible,
         text_color = dashboardText, text_size = f_text_size(dashboardTextSize), text_halign = text.align_left, text_valign = text.align_center)
    table.cell(dashboard, 1, 2, "STRUCTURE\n" + structureState + "\n" + structureDetail,
         width = dashboardColumnWidth, height = dashboardCardHeight,
         bgcolor = visible ? color.new(curPoorHigh or curPoorLow ? poorColor : singlePrintColor, 86) : invisible,
         text_color = dashboardText, text_size = f_text_size(dashboardTextSize), text_halign = text.align_left, text_valign = text.align_center)

    table.cell(dashboard, 0, 3, "OPEN\n" + openDetail,
         width = dashboardColumnWidth, height = dashboardCardHeight,
         bgcolor = visible ? color.new(secondaryColor, 86) : invisible,
         text_color = dashboardText, text_size = f_text_size(dashboardTextSize), text_halign = text.align_left, text_valign = text.align_center)
    table.cell(dashboard, 1, 3, "LOCATION\n" + locationDetail + "\nAbove/Below POC " + str.tostring(curTpoAbove) + "/" + str.tostring(curTpoBelow),
         width = dashboardColumnWidth, height = dashboardCardHeight,
         bgcolor = visible ? color.new(currentLocation == "Above Value" ? bullishColor : currentLocation == "Below Value" ? bearishColor : neutralColor, 86) : invisible,
         text_color = dashboardText, text_size = f_text_size(dashboardTextSize), text_halign = text.align_left, text_valign = text.align_center)

    table.cell(dashboard, 0, 4, footer,
         width = dashboardColumnWidth * 2, height = dashboardFooterHeight,
         bgcolor = visible ? color.new(panelColor, 14) : invisible,
         text_color = chartWarning or currentOverflow or previousOverflow ? (visible ? poorColor : color.new(poorColor, 100)) : dashboardMuted,
         text_size = size.tiny, text_halign = text.align_center)

bool previousPocEvent = barstate.isconfirmed and alertPreviousLevels and previousPocTouched and not previousPocTouched[1]
bool previousVahEvent = barstate.isconfirmed and alertPreviousLevels and previousVahTouched and not previousVahTouched[1]
bool previousValEvent = barstate.isconfirmed and alertPreviousLevels and previousValTouched and not previousValTouched[1]
bool singlePrintEvent = barstate.isconfirmed and alertSinglePrints and previousSinglePrintOverlap and not previousSinglePrintOverlap[1]
bool poorHighEvent = barstate.isconfirmed and alertPoorHighLow and poorHighRepaired and not poorHighRepaired[1]
bool poorLowEvent = barstate.isconfirmed and alertPoorHighLow and poorLowRepaired and not poorLowRepaired[1]
bool auctionChangeEvent = barstate.isconfirmed and alertAuctionChanges and inRTH and auctionCode != auctionCode[1]

string dynamicEvent = previousPocEvent ? "previous_poc_test" :
     previousVahEvent ? "previous_vah_test" :
     previousValEvent ? "previous_val_test" :
     singlePrintEvent ? "single_print_test" :
     poorHighEvent ? "poor_high_repair" :
     poorLowEvent ? "poor_low_repair" :
     auctionChangeEvent ? "auction_state_change" : ""

if enableDynamicAlerts and str.length(dynamicEvent) > 0
    string jsonMessage = "{" +
         "\"source\":\"meridian_futures_profile\"," +
         "\"version\":\"0.1.1\"," +
         "\"event\":\"" + dynamicEvent + "\"," +
         "\"symbol\":\"" + syminfo.tickerid + "\"," +
         "\"timeframe\":\"" + timeframe.period + "\"," +
         "\"auction_state\":\"" + auctionState + "\"," +
         "\"profile_shape\":\"" + curShapeText + "\"," +
         "\"value_relationship\":\"" + valueRelationship + "\"," +
         "\"poc\":" + str.tostring(nz(curPoc), format.mintick) + "," +
         "\"vah\":" + str.tostring(nz(curVah), format.mintick) + "," +
         "\"val\":" + str.tostring(nz(curVal), format.mintick) + "," +
         "\"previous_poc\":" + str.tostring(nz(prevPoc), format.mintick) + "," +
         "\"rotation_factor\":" + str.tostring(currentRotationFactor, "#.##") + "," +
         "\"bar_time\":" + str.tostring(time) + "}"
    alert(jsonMessage, alert.freq_once_per_bar_close)

alertcondition(previousPocEvent, "Meridian — Previous TPO POC tested", "Meridian Futures Profile: price tested the previous completed RTH TPO POC.")
alertcondition(previousVahEvent, "Meridian — Previous TPO VAH tested", "Meridian Futures Profile: price tested the previous completed RTH TPO VAH.")
alertcondition(previousValEvent, "Meridian — Previous TPO VAL tested", "Meridian Futures Profile: price tested the previous completed RTH TPO VAL.")
alertcondition(singlePrintEvent, "Meridian — Previous single-print zone tested", "Meridian Futures Profile: price entered a previous completed RTH single-print zone.")
alertcondition(poorHighEvent, "Meridian — Poor high repaired", "Meridian Futures Profile: price traded above the previous poor high.")
alertcondition(poorLowEvent, "Meridian — Poor low repaired", "Meridian Futures Profile: price traded below the previous poor low.")
alertcondition(auctionChangeEvent, "Meridian — Auction state changed", "Meridian Futures Profile: the confirmed Auction Market Theory state changed.")
