indicator(
     title = "Meridian — Futures Profile",
     shorttitle = "Meridian Futures Profile",
     overlay = true,
     format = format.price,
     precision = 2,
     max_bars_back = 5000,
     max_boxes_count = 500,
     max_lines_count = 250,
     max_labels_count = 300,
     explicit_plot_zorder = true)

