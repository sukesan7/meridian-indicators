float estimatedVolumeValueArea = input.float(70.0, "Estimated volume value area", minval = 50.0, maxval = 95.0, step = 1.0, group = G_VOLUME)

float doublePeakMinimumRatio = input.float(0.62, "Double-distribution secondary peak", minval = 0.30, maxval = 1.0, step = 0.01, group = G_AMT)
float doublePeakValleyRatio = input.float(0.55, "Double-distribution valley ratio", minval = 0.10, maxval = 0.90, step = 0.01, group = G_AMT)
int doublePeakMinimumSeparation = input.int(5, "Minimum peak separation (rows)", minval = 2, maxval = 30, group = G_AMT)
