indicator(
     "Meridian - Futures Setups Research",
     shorttitle = "Meridian Setups Research",
     overlay = true,
     max_bars_back = 5000,
     max_lines_count = 500,
     max_boxes_count = 500,
     max_labels_count = 500,
     dynamic_requests = true)

const string VERSION = "0.4.0-beta"
const bool RESEARCH_BUILD = true
const int DIR_BULL = 1
const int DIR_BEAR = -1
const int DIR_NONE = 0

const int Z_ACTIVE = 0
const int Z_TRIGGERED = 1
const int Z_INVALID = 2
const int Z_EXPIRED = 3

const int T_ACTIVE = 0
const int T_COMPLETED = 1
const int T_STOPPED = 2
const int T_EXPIRED = 3

const int MAX_ZONES = 140
const int MAX_PIVOTS = 60
const int MAX_TRADES = 20
const int MAX_SESSION_SLOTS = 1500
const int MAX_RVOL_SESSIONS = 60
const int MAX_LIQUIDITY_POOLS = 24
const int POOL_SUPPORT = 1
const int POOL_RESISTANCE = -1

type Zone
    string id
    string zoneType
    string sourceTf
    int sourceRank
    int direction
    float top
    float bottom
    float midpoint
    float sourceAtr
    float sizeAtr
    float sizePercentile
    int originTime
    int detectedTime
    int detectedBar
    int expiryTime
    float lifetimeFactor
    int state
    int terminalTime
    int touchCount
    bool wasIntersecting
    float fillPercent
    int score
    int categoryCount
    bool candidateCounted
    string scoreBreakdown
    string rejectionReason
    int structuralLegId
    box zoneBox
    label zoneLabel

type PivotMark
    float price
    int side
    int originBar
    int originTime

type LiquidityPool
    string id
    int side
    float price
    int touches
    int firstBar
    int lastTouchBar
    int firstTime
    int lastTouchTime
    int qualifiedTime
    bool active
    int terminalTime
    line poolLine
    label poolLabel

type Trade
    string id
    string zoneId
    string zoneType
    string sourceTf
    int direction
    int state
    int score
    int categoryCount
    string evidence
    int entryTime
    int entryBar
    int plannedEndTime
    int terminalTime
    float entryPrice
    float stopPrice
    float target1
    float target15
    float target2
    bool target1Hit
    bool target15Hit
    box setupBox
    box riskBox
    box reward1Box
    box reward15Box
    box reward2Box
    line stopLine
    line target1Line
    line target15Line
    line target2Line
    label signalLabel
    label stopLabel
    label target1Label
    label target15Label
    label target2Label
    label outcomeLabel

var Zone[] zones = array.new<Zone>()
