indicator(
     title = "Meridian - Options Levels",
     shorttitle = "Meridian Options Levels",
     overlay = true,
     max_bars_back = 1000,
     max_boxes_count = 8,
     behind_chart = true
)

string GROUP_SESSIONS = "01. Sessions"
string GROUP_DISPLAY = "02. Display"
